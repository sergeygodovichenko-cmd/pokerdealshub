---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getAlternateLanguages } from '../i18n/utils';
import { isRtl } from '../i18n/ui';
import GA4 from '../components/GA4.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  canonical?: string; // 👈 добавили поддержку кастомного каноникала
}

const { title, description, ogImage, breadcrumbs, canonical } = Astro.props;

// === Canonical URL ===
let pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const defaultCanonical = new URL(pathname, Astro.site);
const canonicalURL = canonical
  ? canonical
  : defaultCanonical.toString();

// === Языки ===
const currentLang = getLangFromUrl(Astro.url);
const alternateLanguages = getAlternateLanguages(Astro.url.pathname, currentLang);

// === Structured data ===
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalURL,
  inLanguage: currentLang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'PokerDealsHub',
    url: Astro.site?.toString(),
  },
};

// 👇 вот чего у тебя не хватало
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PokerDealsHub',
  url: Astro.site?.toString(),
  logo: new URL('/PDH_logo_no_background.webp', Astro.site).toString(),
  sameAs: [
    'https://t.me/pokerdealshub',
    'https://www.instagram.com/poker_deals_hub/',
  ],
};

const breadcrumbSchema = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.url, Astro.site).toString(),
      })),
    }
  : null;
---

<!doctype html>
<html lang={currentLang} dir={isRtl(currentLang) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternate language versions -->
    {alternateLanguages.map(({ lang, path }) => (
      <link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />
    ))}
    <!-- x-default -->
    <link rel="alternate" hreflang="x-default" href={Astro.site} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={
        ogImage
          ? new URL(ogImage, Astro.site)
          : 'https://pokerdealshub.com/og/og-image-default.webp'
      }
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <GA4 />
  </head>

  <body class="bg-neutral-950 text-neutral-100 min-h-screen flex flex-col w-full overflow-x-hidden">
    <Header />
    <main class="flex-1 pt-12 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
