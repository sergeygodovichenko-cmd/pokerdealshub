---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import RelatedDeals from "../../../components/RelatedDeals.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import { locales, type Locale } from "../../../i18n/ui";
import { badgeLabels, tooltips, labl, localizeDeal } from "../../../utils/dealHelpers";

export async function getStaticPaths() {
  const deals = await getCollection("deals", ({ data }) => !data.hidden);
  return locales.flatMap((lang) =>
    deals.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { deal: entry.data, slug: entry.id },
    }))
  );
}

const { deal, slug } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const L = labl[lang];

const loc = localizeDeal(deal, lang);

const renderStars = (rating: number) => "★".repeat(rating) + "☆".repeat(5 - rating);

const title = loc.name;
const description = loc.description;

const breadcrumbs = [
  { name: t("breadcrumb.deals"), url: `/${lang}/deals/` },
  { name: loc.name, url: `/${lang}/deal/${slug}/` },
];

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  name: title,
  description,
  url: `https://pokerdealshub.com/${lang}/deal/${slug}/`,
  category: deal.type,
  itemOffered: {
    "@type": "Service",
    name: deal.app,
    provider: {
      "@type": "Organization",
      name: deal.union && deal.union !== "-" ? deal.union : "PokerDealsHub",
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-5xl mx-auto">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-6">
        {loc.name}
      </h1>

      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 lg:p-8 mb-8">
        <!-- Mobile: logo + badges -->
        <div class="flex gap-4 mb-6 lg:hidden">
          <div class="flex-shrink-0">
            <img src={deal.logoimage} alt={deal.logoalt || loc.name} class="w-32 sm:w-40 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex flex-col gap-2">
            {deal.badges?.map((badge) => {
              const badgeText = badgeLabels[lang][badge as keyof typeof badgeLabels["ru"]] || badge;
              if (badge === "pdhClub") {
                return (
                  <button type="button" data-badge-tooltip class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group text-left w-fit">
                    {badgeText}
                    <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
                      {tooltips[lang].featured}
                    </span>
                  </button>
                );
              }
              return (
                <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50 w-fit">
                  {badgeText}
                </span>
              );
            })}
          </div>
        </div>

        <!-- Desktop: logo + info grid -->
        <div class="hidden lg:flex lg:flex-row lg:items-start gap-6 mb-6">
          <div class="flex-shrink-0">
            <img src={deal.logoimage} alt={deal.logoalt || loc.name} class="w-48 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-neutral-100 mb-4">{loc.name}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm lg:text-base">
              {deal.club && deal.club !== "-" && (
                <div><span class="text-neutral-400">{L.club}</span><span class="text-neutral-100 ml-2 font-medium">{deal.club}</span></div>
              )}
              {deal.union && deal.union !== "-" && deal.union !== "None" && (
                <div><span class="text-neutral-400">{L.union}</span><span class="text-neutral-100 ml-2 font-medium">{deal.union}</span></div>
              )}
              <div><span class="text-neutral-400">{L.geog}</span><span class="text-neutral-100 ml-2 font-medium">{loc.geo}</span></div>
              <div><span class="text-neutral-400">{L.platform}</span><span class="text-neutral-100 ml-2 font-medium">{deal.app}</span></div>
              {loc.bonus && (
                <div><span class="text-neutral-400">{L.bonusL}</span><span class="text-gold ml-2 font-medium">{loc.bonus}</span></div>
              )}
              <div>
                <span class="inline-block px-2 py-1 rounded-lg font-semibold text-green-300 border border-green-400/60 bg-green-950/40 shadow-[0_0_10px_rgba(0,255,0,0.15)]">
                  {L.upTo} {deal.rakeback}
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile: info grid -->
        <div class="lg:hidden mb-6">
          <h2 class="text-xl font-bold text-neutral-100 mb-3">{loc.name}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            {deal.club && deal.club !== "-" && (
              <div><span class="text-neutral-400">{L.club}</span><span class="text-neutral-100 ml-2 font-medium">{deal.club}</span></div>
            )}
            {deal.union && deal.union !== "-" && deal.union !== "None" && (
              <div><span class="text-neutral-400">{L.union}</span><span class="text-neutral-100 ml-2 font-medium">{deal.union}</span></div>
            )}
            <div><span class="text-neutral-400">{L.geog}</span><span class="text-neutral-100 ml-2 font-medium">{loc.geo}</span></div>
            <div><span class="text-neutral-400">{L.platform}</span><span class="text-neutral-100 ml-2 font-medium">{deal.app}</span></div>
            {loc.bonus && (
              <div><span class="text-neutral-400">{L.bonusL}</span><span class="text-gold ml-2 font-medium">{loc.bonus}</span></div>
            )}
            <div>
              <span class="inline-block px-2 py-1 rounded-lg font-semibold text-green-300 border border-green-400/60 bg-green-950/40 shadow-[0_0_10px_rgba(0,255,0,0.15)]">
                {L.upTo} {deal.rakeback}
              </span>
            </div>
          </div>
        </div>

        <!-- Desktop: badges -->
        <div class="hidden lg:flex flex-wrap gap-2 mb-6 relative">
          {deal.badges?.map((badge) => {
            const badgeText = badgeLabels[lang][badge as keyof typeof badgeLabels["ru"]] || badge;
            if (badge === "pdhClub") {
              return (
                <button type="button" data-badge-tooltip class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group text-left w-fit">
                  {badgeText}
                  <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
                    {tooltips[lang].featured}
                  </span>
                </button>
              );
            }
            return (
              <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50 w-fit">
                {badgeText}
              </span>
            );
          })}
        </div>

        <button id="ctaButton" class="w-full sm:w-auto px-8 py-4 bg-gold text-neutral-900 rounded-xl font-bold text-lg hover:bg-gold-light transition-all mb-6">
          {L.getDeal}
        </button>

        <h3 class="text-xl font-bold text-neutral-100 mb-3">{L.rateBy}</h3>
        <div class="flex flex-wrap gap-6 items-center mb-4">
          <div class="flex items-center gap-2"><span class="text-neutral-400 text-sm">MTT</span><span class="text-gold text-lg">{renderStars(deal.ratings.mtt)}</span></div>
          <div class="flex items-center gap-2"><span class="text-neutral-400 text-sm">PLO</span><span class="text-gold text-lg">{renderStars(deal.ratings.plo)}</span></div>
          <div class="flex items-center gap-2"><span class="text-neutral-400 text-sm">NLH</span><span class="text-gold text-lg">{renderStars(deal.ratings.nlh)}</span></div>
        </div>

        <!-- Editorial body -->
        {loc.body && (
          <div
            class="prose prose-invert max-w-none mb-8
                   [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-neutral-100 [&_h2]:mt-8 [&_h2]:mb-3
                   [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-neutral-100 [&_h3]:mt-8 [&_h3]:mb-3
                   [&_p]:text-neutral-300 [&_p]:leading-relaxed [&_p]:mb-4
                   [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-2 [&_li]:text-neutral-300 [&_li::marker]:text-gold
                   [&_strong]:text-neutral-100
                   [&_a]:text-gold [&_a:hover]:text-gold-light [&_a]:underline [&_a]:underline-offset-2"
            set:html={loc.body}
          />
        )}

        <!-- PDH verified -->
        <div class="flex items-center gap-3 mb-6 text-neutral-300 leading-relaxed">
          <img src="/pdh_verif.webp" alt="PDH Verified" class="w-[68px] h-[68px] flex-shrink-0 select-none translate-y-[2px]" loading="lazy" />
          <p>{L.verif}</p>
        </div>

        <!-- Contact -->
        <div id="contactSection" class="bg-gold/10 border border-gold/30 rounded-xl p-6 text-center">
          <h3 class="text-2xl font-bold text-gold mb-3">{L.readyJoin}</h3>
          <p class="text-neutral-300 mb-6">{L.weAreHereNoKyc} <br />{L.weAreHere2}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://t.me/pdh_support_bot" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#006699] text-white rounded-xl font-bold text-lg hover:bg-[#00557a] transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.654-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/></svg>
              {L.tgContact}
            </a>
            <a href="https://discord.gg/Zgdmf6szS" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#5865F2] text-white rounded-xl font-bold text-lg hover:bg-[#4752C4] transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
              {L.discordContact}
            </a>
          </div>
        </div>
      </div>

      <RelatedDeals
        currentDealSlug={slug}
        currentApp={deal.app}
        currentGeo={deal.geo}
        currentBadges={deal.badges}
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />

  <script>
    document.getElementById("ctaButton")?.addEventListener("click", () => {
      document.getElementById("contactSection")?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

    function positionTooltips() {
      document.querySelectorAll("[data-badge-tooltip]").forEach((badge) => {
        const tooltip = badge.querySelector(".pdh-tooltip") as HTMLElement | null;
        if (!tooltip) return;
        const rect = badge.getBoundingClientRect();
        const pct = ((rect.left + rect.width / 2) / window.innerWidth) * 100;
        tooltip.style.removeProperty("left");
        tooltip.style.removeProperty("right");
        tooltip.style.removeProperty("transform");
        if (pct >= 40 && pct <= 60) { tooltip.style.left = "50%"; tooltip.style.transform = "translateX(-50%)"; }
        else if (pct < 40) { tooltip.style.left = "0"; }
        else { tooltip.style.right = "0"; }
      });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", positionTooltips);
    else positionTooltips();
    window.addEventListener("resize", positionTooltips);
  </script>
</BaseLayout>
