---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { useTranslations } from "../../../i18n/utils";
import { locales } from "../../../i18n/ui";
import { getCollection } from "astro:content";
import { localizeGuide } from "../../../utils/dealHelpers";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const t = useTranslations(lang as any);

const all = await getCollection("guides", ({ data }) => !data.draft);
const guides = all
  .map((entry) => ({ slug: entry.id, ...entry.data, ...localizeGuide(entry.data, lang) }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const dateLocale: Record<string, string> = { ru: "ru-RU", en: "en-US", uz: "uz-UZ", uk: "uk-UA", it: "it-IT", de: "de-DE", es: "es-ES", pt: "pt-BR", fr: "fr-FR", tr: "tr-TR", he: "he-IL", ar: "ar", id: "id-ID", vi: "vi-VN", fil: "fil-PH" };
const catLabel: Record<string, { guide: string; review: string }> = {
  ru: { guide: "Гайд", review: "Обзор" },
  en: { guide: "Guide", review: "Review" },
  uz: { guide: "Qo‘llanma", review: "Sharh" },
  uk: { guide: "Гайд", review: "Огляд" },
  it: { guide: "Guida", review: "Recensione" },
  de: { guide: "Guide", review: "Review" },
  es: { guide: "Guía", review: "Reseña" },
  pt: { guide: "Guia", review: "Análise" },
  fr: { guide: "Guide", review: "Analyse" },
  tr: { guide: "Rehber", review: "İnceleme" },
  he: { guide: "מדריך", review: "סקירה" },
  ar: { guide: "دليل", review: "مراجعة" },
  id: { guide: "Panduan", review: "Ulasan" },
  vi: { guide: "Hướng dẫn", review: "Đánh giá" },
  fil: { guide: "Gabay", review: "Review" },
};
const readMore: Record<string, string> = { ru: "Читать далее", en: "Read more", uz: "Batafsil", uk: "Читати далі", it: "Leggi di più", de: "Mehr lesen", es: "Leer más", pt: "Leia mais", fr: "Lire la suite", tr: "Devamını oku", he: "קרא עוד", ar: "اقرأ المزيد", id: "Baca selengkapnya", vi: "Đọc thêm", fil: "Magbasa pa" };
const aboutBlock: Record<string, { title: string; p1: string; p2: string }> = {
  ru: {
    title: "О разделе гайдов",
    p1: "В этом разделе мы публикуем подробные гайды и обзоры покерных приложений, союзов и сделок. Наша цель — помочь разобраться в условиях игры и выбрать лучшее предложение.",
    p2: "Все материалы основаны на реальном игровом опыте и проверенной информации.",
  },
  en: {
    title: "About the Guides Section",
    p1: "Here we publish detailed guides and reviews of poker apps, unions, and deals. Our goal is to help you understand the playing conditions and choose the best offer.",
    p2: "All guides are based on real playing experience and verified information.",
  },
  uz: {
    title: "Qo‘llanmalar bo‘limi haqida",
    p1: "Bu bo‘limda poker ilovalari, ittifoqlar va bitimlar bo‘yicha batafsil qo‘llanma va sharhlar chop etamiz. Maqsadimiz — o‘yin shartlarini tushunishga va eng yaxshi taklifni tanlashga yordam berish.",
    p2: "Barcha materiallar haqiqiy o‘yin tajribasi va tekshirilgan ma'lumotlarga asoslangan.",
  },
  uk: {
    title: "Про розділ гайдів",
    p1: "У цьому розділі ми публікуємо докладні гайди та огляди покерних застосунків, союзів і угод. Наша мета — допомогти розібратися в умовах гри та обрати найкращу пропозицію.",
    p2: "Усі матеріали ґрунтуються на реальному ігровому досвіді та перевіреній інформації.",
  },
  it: {
    title: "Informazioni sulla sezione Guide",
    p1: "Qui pubblichiamo guide dettagliate e recensioni di app di poker, union e offerte. Il nostro obiettivo è aiutarti a comprendere le condizioni di gioco e a scegliere l’offerta migliore.",
    p2: "Tutte le guide si basano su un’esperienza di gioco reale e su informazioni verificate.",
  },
  de: {
    title: "Über den Guides-Bereich",
    p1: "Hier veröffentlichen wir ausführliche Guides und Reviews zu Poker-Apps, Unions und Deals. Unser Ziel ist es, dir zu helfen, die Spielbedingungen zu verstehen und das beste Angebot zu wählen.",
    p2: "Alle Guides basieren auf echter Spielerfahrung und geprüften Informationen.",
  },
  es: {
    title: "Sobre la sección de guías",
    p1: "Aquí publicamos guías detalladas y reseñas de apps de póker, uniones y ofertas. Nuestro objetivo es ayudarte a entender las condiciones de juego y a elegir la mejor oferta.",
    p2: "Todas las guías se basan en experiencia de juego real e información verificada.",
  },
  pt: {
    title: "Sobre a seção de guias",
    p1: "Aqui publicamos guias detalhados e análises de apps de poker, uniões e ofertas. Nosso objetivo é ajudar você a entender as condições de jogo e a escolher a melhor oferta.",
    p2: "Todos os guias são baseados em experiência de jogo real e informações verificadas.",
  },
  fr: {
    title: "À propos de la section guides",
    p1: "Ici, nous publions des guides détaillés et des analyses d’apps de poker, d’unions et d’offres. Notre objectif est de vous aider à comprendre les conditions de jeu et à choisir la meilleure offre.",
    p2: "Tous les guides reposent sur une expérience de jeu réelle et des informations vérifiées.",
  },
  tr: {
    title: "Rehberler bölümü hakkında",
    p1: "Burada poker uygulamaları, birlikler ve teklifler hakkında ayrıntılı rehberler ve incelemeler yayınlıyoruz. Amacımız oyun koşullarını anlamanıza ve en iyi teklifi seçmenize yardımcı olmaktır.",
    p2: "Tüm rehberler gerçek oyun deneyimine ve doğrulanmış bilgilere dayanır.",
  },
  he: {
    title: "אודות מדור המדריכים",
    p1: "כאן אנחנו מפרסמים מדריכים מפורטים וסקירות של אפליקציות פוקר, איגודים ועסקאות. המטרה שלנו היא לעזור לכם להבין את תנאי המשחק ולבחור את ההצעה הטובה ביותר.",
    p2: "כל המדריכים מבוססים על ניסיון משחק אמיתי ומידע מאומת.",
  },
  ar: {
    title: "حول قسم الأدلة",
    p1: "هنا ننشر أدلة مفصلة ومراجعات لتطبيقات البوكر والاتحادات والصفقات. هدفنا هو مساعدتك على فهم شروط اللعب واختيار أفضل عرض.",
    p2: "تستند جميع الأدلة إلى تجربة لعب حقيقية ومعلومات موثقة.",
  },
  id: {
    title: "Tentang bagian panduan",
    p1: "Di sini kami menerbitkan panduan terperinci dan ulasan aplikasi poker, union, dan penawaran. Tujuan kami adalah membantu kamu memahami kondisi permainan dan memilih penawaran terbaik.",
    p2: "Semua panduan didasarkan pada pengalaman bermain nyata dan informasi terverifikasi.",
  },
  vi: {
    title: "Về mục hướng dẫn",
    p1: "Tại đây chúng tôi đăng các hướng dẫn chi tiết và đánh giá về ứng dụng poker, liên minh và ưu đãi. Mục tiêu của chúng tôi là giúp bạn hiểu điều kiện chơi và chọn ưu đãi tốt nhất.",
    p2: "Tất cả hướng dẫn đều dựa trên kinh nghiệm chơi thực tế và thông tin đã được xác minh.",
  },
  fil: {
    title: "Tungkol sa seksyon ng mga gabay",
    p1: "Dito kami naglalathala ng detalyadong gabay at review ng mga poker app, union, at deals. Layunin namin na tulungan kang maunawaan ang mga kondisyon ng laro at piliin ang pinakamahusay na alok.",
    p2: "Lahat ng gabay ay batay sa tunay na karanasan sa paglalaro at na-verify na impormasyon.",
  },
};
const about = aboutBlock[lang] ?? aboutBlock.en;

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: guides.map((g, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Article",
      headline: g.title,
      description: g.description,
      datePublished: new Date(g.date).toISOString().slice(0, 10),
      url: `https://pokerdealshub.com/${lang}/guides/${g.slug}/`,
    },
  })),
};
---

<BaseLayout title={`${t("guides.title")} — PokerDealsHub`} description={t("guides.subtitle")}>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gold mb-6">{t("guides.title")}</h1>
      <p class="text-neutral-300 text-lg">{t("guides.subtitle")}</p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 gap-6">
        {guides.map((guide) => (
          <article class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 hover:border-gold transition-all group">
            <div class="flex items-start justify-between mb-3">
              <span class={`text-xs px-3 py-1 rounded-full ${guide.category === "guide" ? "bg-blue-500/20 text-blue-400" : "bg-green-500/20 text-green-400"}`}>
                {(catLabel[lang] ?? catLabel.en)[guide.category as "guide" | "review"]}
              </span>
              <time class="text-sm text-neutral-500">
                {new Date(guide.date).toLocaleDateString(dateLocale[lang] ?? "en-US", { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </div>
            <h2 class="text-2xl font-semibold text-gold group-hover:text-gold-light transition-colors mb-3">
              <a href={`/${lang}/guides/${guide.slug}/`}>{guide.title}</a>
            </h2>
            <p class="text-neutral-400 mb-4">{guide.description}</p>
            <a href={`/${lang}/guides/${guide.slug}/`} class="inline-flex items-center text-gold hover:text-gold-light transition-colors text-sm font-medium">
              {readMore[lang] ?? readMore.en}
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-12 bg-neutral-900 border border-neutral-800 rounded-xl p-8">
        <h2 class="text-2xl font-semibold text-gold mb-4">{about.title}</h2>
        <p class="text-neutral-300 mb-4">{about.p1}</p>
        <p class="text-neutral-300">{about.p2}</p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</BaseLayout>
