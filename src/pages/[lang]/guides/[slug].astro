---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import { locales } from "../../../i18n/ui";
import { localizeGuide } from "../../../utils/dealHelpers";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return locales.flatMap((lang) =>
    guides.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { data: entry.data, slug: entry.id },
    }))
  );
}

const { data, slug } = Astro.props;
const lang = Astro.params.lang as string;
const t = useTranslations(lang as any);
const g = localizeGuide(data, lang);

const breadcrumbs = [
  { name: t("breadcrumb.home"), url: `/${lang}/` },
  { name: t("breadcrumb.guides"), url: `/${lang}/guides/` },
  { name: g.title, url: `/${lang}/guides/${slug}/` },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: g.title,
  description: g.description,
  datePublished: new Date(data.date).toISOString().slice(0, 10),
  inLanguage: lang,
  url: `https://pokerdealshub.com/${lang}/guides/${slug}/`,
  author: { "@type": "Organization", name: "PokerDealsHub" },
  publisher: {
    "@type": "Organization",
    name: "PokerDealsHub",
    logo: { "@type": "ImageObject", url: "https://pokerdealshub.com/PDH_logo_no_background.webp" },
  },
};
---

<BaseLayout
  title={`${g.title} — PokerDealsHub`}
  description={g.description}
  breadcrumbs={breadcrumbs}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-8 lg:pt-12 lg:pb-12">
    <div class="max-w-3xl mx-auto">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-6 lg:mb-8 leading-tight">
        {g.title}
      </h1>

      <div
        class="text-neutral-300 text-base lg:text-lg leading-relaxed
               [&_p]:mb-5 [&_h2]:text-2xl [&_h2]:lg:text-3xl [&_h2]:text-gold [&_h2]:font-semibold [&_h2]:mt-8 [&_h2]:mb-4
               [&_h3]:text-xl [&_h3]:text-gold [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-3
               [&_ul]:list-disc [&_ul]:list-outside [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-2 [&_li::marker]:text-gold
               [&_a]:text-gold [&_a:hover]:text-gold-light [&_a:hover]:underline [&_a]:transition-colors
               [&_strong]:text-neutral-100 [&_strong]:font-semibold [&_em]:text-neutral-200"
        set:html={g.body}
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
