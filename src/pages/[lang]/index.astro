    ctaButton: 'Разместить сделку',
  },
  en: {
    metaTitle: 'PokerDealsHub — the best poker clubs and rakeback offers',
    metaDescription: 'Choose verified poker clubs and unions on PPPoker, ClubGG, and X-Poker. Get high rakeback and reliable payouts with PokerDealsHub.',
    heroTitle: 'PokerDealsHub — the best rakeback deals in the poker world',
    heroText: 'We’ve gathered the best poker clubs and unions with high rakeback and transparent terms. Only trusted platforms and soft games — everything to help you get the most out of poker.',
    heroCta: 'All poker deals',
    whyTitle: 'Why players choose PokerDealsHub',
