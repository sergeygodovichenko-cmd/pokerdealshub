---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealCard from '../../components/DealCard.astro';
import { getDeals } from '../../utils/deals';
import { getCollection } from 'astro:content';
import { localizeGuide } from '../../utils/dealHelpers';
import { useTranslations } from '../../i18n/utils';
import { locales } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const deals = (await getDeals()).sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .map((e) => ({ slug: e.id, date: e.data.date, ...localizeGuide(e.data, lang) }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const t = useTranslations(lang as any);

const STR = {
  ru: {
