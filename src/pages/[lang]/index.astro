          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
        </svg>
        <span class="sr-only">{s.dealNextSr}</span>
      </button>

      <div class="hidden sm:flex md:hidden justify-center gap-6 mt-6">
        <button
          onclick="document.getElementById('deal-viewport').scrollBy({ left: -document.getElementById('deal-viewport').offsetWidth, behavior: 'smooth' })"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800/80 text-gold border border-gold/40
                 drop-shadow-[0_0_6px_rgba(212,175,55,0.3)] hover:scale-110 transition-all"
        >
          <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' class='w-5 h-5'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
          </svg>
          <span class="sr-only">{s.dealPrevSr}</span>
        </button>
        <button
          onclick="document.getElementById('deal-viewport').scrollBy({ left: document.getElementById('deal-viewport').offsetWidth, behavior: 'smooth' })"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800/80 text-gold border border-gold/40
                 drop-shadow-[0_0_6px_rgba(212,175,55,0.3)] hover:scale-110 transition-all"
        >
          <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' class='w-5 h-5'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
          </svg>
          <span class="sr-only">{s.dealNextSr}</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .no-overscroll { overscroll-behavior-x: contain; }
  </style>
</section>

<!-- GUIDES -->
<section class="py-12 md:py-14 bg-neutral-950 border-t border-neutral-900 relative">
  <div class="container mx-auto px-6 md:px-12">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-6">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gold mb-2">{s.guidesTitle}</h2>
        <p class="text-neutral-300 text-base max-w-2xl">
          {s.guidesSubtitle}
        </p>
      </div>
      <a href=`/${lang}/guides/` class="mt-4 md:mt-0 text-gold hover:text-gold-light text-sm md:text-base whitespace-nowrap">
        {s.guidesAllLink}
      </a>
    </div>

    <div class="relative flex flex-col items-center md:block w-full">
      <button
        id="guide-prev"
        class="hidden md:flex items-center justify-center absolute left-0 top-1/2 -translate-y-1/2
               w-12 h-12 rounded-full bg-neutral-800/80 text-gold border border-gold/40
               drop-shadow-[0_0_10px_rgba(212,175,55,0.3)]
               hover:drop-shadow-[0_0_10px_rgba(212,175,55,0.8)] hover:scale-110 transition-all z-10"
        aria-label={s.guidePrevAria}
      >
        <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' class='w-6 h-6'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
        </svg>
        <span class="sr-only">{s.guidePrevSr}</span>
      </button>

      <div
      id="guide-viewport"
      class="relative mx-auto overflow-x-auto overflow-y-hidden rounded-2xl scroll-smooth touch-pan-x touch-pan-y
             snap-x snap-mandatory hide-scrollbar w-full md:w-[calc(100%-10rem)]"
    >
        <div id="guide-track" class="flex">
          {guides.slice(0, 6).map((guide) => (
            <a
              href={`/${lang}/guides/${guide.slug}/`}
              class="guide-slide flex-shrink-0 w-full xl:w-1/2 snap-start px-3 md:px-4"
              style="scroll-snap-stop: always;"
            >
              <div class="h-full bg-neutral-900 border border-neutral-800 rounded-2xl p-6 hover:border-gold/50 transition-all flex flex-col">
                <h3 class="text-xl font-bold text-gold mb-3 line-clamp-2">{guide.title}</h3>
                <p class="text-neutral-300 text-sm line-clamp-4 flex-1">{guide.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <button
        id="guide-next"
        class="hidden md:flex items-center justify-center absolute right-0 top-1/2 -translate-y-1/2
               w-12 h-12 rounded-full bg-neutral-800/80 text-gold border border-gold/40
               drop-shadow-[0_0_10px_rgba(212,175,55,0.3)]
               hover:drop-shadow-[0_0_10px_rgba(212,175,55,0.8)] hover:scale-110 transition-all z-10"
        aria-label={s.guideNextAria}
      >
        <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' class='w-6 h-6'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
        </svg>
        <span class="sr-only">{s.guideNextSr}</span>
      </button>
    </div>

    <div class="flex md:hidden justify-center gap-6 mt-6">
      <button
        id="guide-prev-mobile"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800/80 text-gold border border-gold/40
               drop-shadow-[0_0_6px_rgba(212,175,55,0.3)] hover:scale-110 transition-all"
      >
        <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' class='w-5 h-5'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
        </svg>
        <span class="sr-only">{s.guidePrevSr}</span>
      </button>
      <button
        id="guide-next-mobile"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800/80 text-gold border border-gold/40
               drop-shadow-[0_0_6px_rgba(212,175,55,0.3)] hover:scale-110 transition-all"
      >
        <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' class='w-5 h-5'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
        </svg>
        <span class="sr-only">{s.guideNextSr}</span>
      </button>
    </div>
  </div>

  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</section>




<script>
  document.addEventListener('DOMContentLoaded', () => {
    const viewport = document.getElementById('guide-viewport');
    const prev = document.getElementById('guide-prev');
    const next = document.getElementById('guide-next');
    const prevM = document.getElementById('guide-prev-mobile');
    const nextM = document.getElementById('guide-next-mobile');
    const slide = viewport?.querySelector('.guide-slide');
    if (!viewport || !slide) return;

    function stepPx(mult = 1) {
      const w = slide.getBoundingClientRect().width;
      return Math.round(w * mult);
    }

    function scrollGuides(dir) {
      viewport.scrollBy({ left: dir * stepPx(1), behavior: 'smooth' });
    }

    prev?.addEventListener('click', () => scrollGuides(-1));
    next?.addEventListener('click', () => scrollGuides(1));
    prevM?.addEventListener('click', () => scrollGuides(-1));
    nextM?.addEventListener('click', () => scrollGuides(1));
  });
</script>

<!-- CTA -->
<section class="py-12 md:py-14 bg-neutral-950 border-t border-neutral-900 text-center">
  <div class="container mx-auto px-6 md:px-12 max-w-3xl">
    <h2 class="text-3xl md:text-4xl font-bold text-gold mb-5">{s.ctaTitle}</h2>
    <p class="text-neutral-300 text-base md:text-lg mb-6 leading-relaxed">
      {s.ctaText}
    </p>
    <a
      href={`/${lang}/add-deal/`}
      class="inline-block px-8 py-3 bg-gold text-neutral-900 font-bold rounded-xl hover:bg-gold-light transition-all text-base md:text-lg"
    >
      {s.ctaButton}
    </a>
    <img
      src="/chip_flying.webp"
      alt="Flying poker chip"
      class="mx-auto mt-10 w-28 md:w-36 opacity-80 animate-chip-float"
    />
  </div>
</section>

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @keyframes chip-float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-12px) rotate(4deg); }
    }
    .animate-chip-float { animation: chip-float 5.5s ease-in-out infinite; }
  </style>

<script is:inline>
  window.addEventListener('load', () => {
    const viewport = document.getElementById('deal-viewport');
    if (!viewport) return;

    const slide = viewport.querySelector('.deal-slide');
    if (!slide) return;

    const slideW = slide.getBoundingClientRect().width || viewport.clientWidth;
    const amount = Math.round(Math.min(slideW * 0.18, 140));
    let done = false;

    function nudge() {
      if (done) return;
      done = true;

      setTimeout(() => {
        const prevSnap = viewport.style.scrollSnapType || '';
        const computedSnap = getComputedStyle(viewport).scrollSnapType;
        const restoreSnap = () => { viewport.style.scrollSnapType = prevSnap || computedSnap; };

        viewport.style.scrollSnapType = 'none';
        viewport.scrollBy({ left: amount, behavior: 'smooth' });
        setTimeout(() => {
          viewport.scrollBy({ left: -amount, behavior: 'smooth' });
          setTimeout(restoreSnap, 1000);
        }, 700);
      }, 500);
    }

    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.99) {
            nudge();
            observer.disconnect();
            break;
          }
        }
      },
      {
        threshold: Array.from({ length: 101 }, (_, i) => i / 100),
      }
    );

    observer.observe(slide);
  });
</script>

</BaseLayout>
