    ctaTitle: 'Add your deal',
    ctaText: 'Own a poker club or union? Games are fair, terms are transparent, and rakeback is clear? List your deal on PokerDealsHub — we’ll bring new players and help your club grow.',
    ctaButton: 'Submit a deal',
  },
  uz: {
    metaTitle: 'PokerDealsHub — eng yaxshi poker bitimlari va rakebek',
    metaDescription: 'PPPoker, ClubGG, X-Poker va boshqa ilovalardagi tasdiqlangan klublar va ittifoqlar. Yuqori rakebek va ishonchli to‘lovlar bilan PDH.',
    heroTitle: 'PokerDealsHub — poker dunyosidagi eng yaxshi rakebek bitimlari',
    heroText: 'Yuqori rakebek va shaffof shartlardagi eng yaxshi poker klublari va ittifoqlarini jamladik. Faqat ishonchli hamkorlar va yumshoq o‘yinlar — maksimal EV uchun.',
    heroCta: 'Barcha poker bitimlari',
    whyTitle: 'Nega o‘yinchilar PokerDealsHub’ni tanlaydi',
    whyCard1Alt: 'Shield icon',
    whyCard1Title: 'Tekshirilgan ittifoqlar',
    whyCard1Text: 'Faqat real to‘lovlar va yaxshi obro‘ga ega klublarni joylaymiz.',
    whyCard2Alt: 'Percent icon',
    whyCard2Title: 'Halol rakebek',
    whyCard2Text: 'Hammasi shaffof — qancha rakebek olayotganingizni doim bilasiz.',
    whyCard3Alt: 'Chat icon',
    whyCard3Title: 'Qo‘llab-quvvatlash 24/7',
    whyCard3Text: 'Jamoamiz har kuni onlayn, tanaffussiz.',
    whyCard4Alt: 'Fish icon',
    whyCard4Title: 'Yumshoq o‘yinlar',
    whyCard4Text: 'Ko‘proq rekreatsion o‘yinchilar va past raqobat.',
    dealsTitle: 'Ommabop bitimlar',
    dealsSubtitle: 'Yuqori rakebek, tasdiqlangan obro‘ va faol stollarga ega eng yaxshi klublar va ittifoqlar.',
    dealsAllLink: 'Barcha bitimlar →',
    dealPrevAria: 'Previous deal',
    dealNextAria: 'Next deal',
    dealPrevSr: 'Oldingi bitim',
    dealNextSr: 'Keyingi bitim',
    guidesTitle: 'Qo‘llanmalar va maslahatlar',
    guidesSubtitle: 'Strategiyalar, ittifoq sharhlari va winrate oshirish uchun amaliy tavsiyalar.',
    guidesAllLink: 'Barcha maqolalar →',
    guidePrevAria: 'Previous guide',
    guideNextAria: 'Next guide',
    guidePrevSr: 'Oldingi maqola',
    guideNextSr: 'Keyingi maqola',
    ctaTitle: 'Bitimingizni qo‘shing',
    ctaText: 'Poker klubingiz yoki ittifoqingiz bormi? O‘yinlar halol, shartlar shaffof va rakebek aniqmi? Bitimni PokerDealsHub’ga joylang — yangi o‘yinchilar olib kelamiz va klub o‘sishiga yordam beramiz.',
