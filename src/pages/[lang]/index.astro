      <div
      id="deal-viewport"
      class="relative mx-auto overflow-x-auto overflow-y-hidden rounded-2xl scroll-smooth touch-pan-x touch-pan-y
             w-full md:w-[calc(100%-10rem)] md:max-w-[1080px]
             snap-x snap-mandatory hide-scrollbar no-overscroll"
    >
        <div id="deal-track" class="flex">
          {deals.slice(0, 6).map((deal) => (
            <div class="deal-slide flex-shrink-0 w-full snap-center px-2 md:px-3">
              <DealCard deal={deal} />
