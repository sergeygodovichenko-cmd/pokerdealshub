---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DealCard from '../../../components/DealCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import deals from '../../../data/deals.json';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return deals.map((deal) => ({
    params: { slug: deal.slug },
    props: { deal },
  }));
}

const { deal } = Astro.props;
const t = useTranslations('en');

const breadcrumbs = [
  { name: t('breadcrumb.home'), url: '/en/' },
  { name: t('breadcrumb.deals'), url: '/en/' },
  { name: deal.name.en, url: `/en/deal/${deal.slug}/` },
];

const similarDeals = deals.filter(
  (d) => d.slug !== deal.slug && (d.app === deal.app || d.geo === deal.geo)
).slice(0, 3);
---

<BaseLayout
  title={deal.name.en}
  description={deal.description.en}
  breadcrumbs={breadcrumbs}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-5xl mx-auto">
      <Breadcrumbs items={breadcrumbs} />
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold">
          {deal.name.en}
        </h1>
        {deal.featured && (
          <span class="inline-flex items-center px-3 py-1 text-sm font-semibold bg-red-500/20 text-red-400 rounded border border-red-500/30">
            🔥 Top Deal
          </span>
        )}
        <span class="inline-flex items-center px-3 py-1 text-sm font-semibold bg-green-500/20 text-green-400 rounded border border-green-500/30">
          ✅ Verified
        </span>
      </div>

      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 lg:p-8 mb-8">
        <div class="flex items-start gap-6 mb-6">
          <div class="w-24 h-24 bg-neutral-800 rounded-lg flex items-center justify-center text-5xl border border-neutral-700 flex-shrink-0">
            {deal.logo === 'pppoker' && '🃏'}
            {deal.logo === 'ggpoker' && '🎰'}
            {deal.logo === 'clubgg' && '🎲'}
            {deal.logo === 'pokerok' && '♠️'}
            {deal.logo === 'xpoker' && '♦️'}
            {deal.logo === '888poker' && '♣️'}
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-neutral-100 mb-3">Key Information</h2>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-neutral-800 text-neutral-300 rounded-lg border border-neutral-700">
                <span class="mr-1">📱</span> {deal.app}
              </span>
              {deal.union !== 'N/A' && (
                <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-neutral-800 text-neutral-300 rounded-lg border border-neutral-700">
                  <span class="mr-1">👥</span> {deal.union}
                </span>
              )}
              <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-neutral-800 text-neutral-300 rounded-lg border border-neutral-700">
                <span class="mr-1">🌍</span> {deal.geo}
              </span>
              <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-neutral-800 text-neutral-300 rounded-lg border border-neutral-700">
                <span class="mr-1">🎯</span> {deal.format}
              </span>
              <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-neutral-800 text-neutral-300 rounded-lg border border-neutral-700">
                <span class="mr-1">⚙️</span> {deal.type}
              </span>
              <span class="inline-flex items-center px-4 py-2 text-base font-bold bg-gold/20 text-gold rounded-lg border border-gold/30">
                <span class="mr-2">💰</span> {deal.rakeback}
              </span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-6 items-center mb-4">
          <div class="flex items-center gap-2">
            <span class="text-neutral-400 text-sm">MTT</span>
            <span class="text-gold text-lg">{'★'.repeat(deal.ratings.mtt) + '☆'.repeat(5 - deal.ratings.mtt)}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-neutral-400 text-sm">PLO</span>
            <span class="text-gold text-lg">{'★'.repeat(deal.ratings.plo) + '☆'.repeat(5 - deal.ratings.plo)}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-neutral-400 text-sm">NLH</span>
            <span class="text-gold text-lg">{'★'.repeat(deal.ratings.nlh) + '☆'.repeat(5 - deal.ratings.nlh)}</span>
          </div>
        </div>

        <div class="prose prose-invert max-w-none mb-8">
          <p class="text-neutral-300 text-lg leading-relaxed">
            {deal.description.en}
          </p>
          <p class="text-neutral-300 leading-relaxed">
            This deal offers favorable terms for players with a transparent rakeback system and reliable support.
            We have thoroughly checked the terms and can recommend this offer for serious play.
          </p>
          <p class="text-neutral-300 leading-relaxed">
            To access the deal, contact us using the button below. Our team will help with registration and
            answer all your questions about playing conditions.
          </p>
        </div>

        <a
          href={deal.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block w-full md:w-auto text-center px-8 py-4 bg-gold text-neutral-900 rounded-xl font-bold text-lg hover:bg-gold-light transition-colors"
          onclick="if(typeof gtag !== 'undefined') gtag('event', 'lead', {'deal_name': '{deal.name.en}'});"
        >
          {t('deal.getButton')}
        </a>
      </div>

      {similarDeals.length > 0 && (
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-neutral-100 mb-6">{t('deal.similarDeals')}</h2>
          <div class="flex flex-col gap-4">
            {similarDeals.map((similarDeal) => (
              <DealCard deal={similarDeal} />
            ))}
          </div>
        </div>
      )}

      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-8">
        <h2 class="text-2xl font-semibold text-gold mb-4">About {deal.name.en}</h2>
        <p class="text-neutral-300">
          This deal is listed on PokerDealsHub after verifying terms and reputation. We regularly update
          information about offers and monitor the relevance of terms. If you have questions or want to learn
          more about {deal.app}, visit the <a href="/en/guides/" class="text-gold hover:text-gold-light">Poker Guide</a> section.
        </p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    'name': deal.name.en,
    'description': deal.description.en,
    'url': `https://pokerdealshub.com/en/deal/${deal.slug}/`,
    'category': deal.type,
    'brand': {
      '@type': 'Brand',
      'name': deal.app,
    },
    'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': ((deal.ratings.mtt + deal.ratings.plo + deal.ratings.nlh + deal.ratings.cash) / 4).toFixed(1),
      'bestRating': '5',
      'worstRating': '1',
      'ratingCount': '1',
    },
    'offers': {
      '@type': 'Offer',
      'availability': 'https://schema.org/InStock',
      'url': `https://pokerdealshub.com/en/deal/${deal.slug}/`,
      'seller': {
        '@type': 'Organization',
        'name': deal.union !== 'N/A' ? deal.union : deal.app,
      },
    },
  })} />
</BaseLayout>
