---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedDeals from '../../../components/RelatedDeals.astro';
import dealsData from '../../../data/deals.json';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { badgeLabels, tooltips } from '../../../utils/dealHelpers';
import { labl } from '../../../utils/dealHelpers';



const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);


//  ✅ correction here 
const deal = dealsData.find(d => d.slug === '888poker');
if (!deal) {
  throw new Error('Deal not found: 888poker');
}

// Tooltip для PDH club из helpers
const pdhTooltip = tooltips.ru.featured;

const breadcrumbs = [
  // { name: t('breadcrumb.home'), url: `/${lang}/deals/` },
  { name: t('breadcrumb.deals'), url: `/${lang}/deals/` },
  { name: deal.name[lang], url: `/${lang}/deal/${deal.slug}/` },
];


const renderStars = (rating) => '★'.repeat(rating) + '☆'.repeat(5 - rating);
const introT = 'Information about the 888Poker room';

const title = `Play at 888Poker with rakeback and a welcome bonus — PokerDealsHub`;
const description = `Get the best conditions at 888Poker by registering through a PDH deal. Rakeback ${deal.rakeback} and a sign-up bonus included.`;

---


<BaseLayout
  title={title} 
  description={description}
  breadcrumbs={breadcrumbs}

>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-5xl mx-auto">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-6">
        Rakeback poker deal at 888Poker <!-- ✅ correction here -->
      </h1>
      

      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 lg:p-8 mb-8">
        <div class="flex gap-4 mb-6 lg:hidden">
          <div class="flex-shrink-0">
            <img src={deal.logoimage} alt={deal.logoalt} class="w-32 sm:w-40 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex flex-col gap-2">
          
          
          
            {deal.badges?.map((badge) => {

  const badgeText = badgeLabels.ru[badge as keyof typeof badgeLabels.ru] || badge;
  


  if (badge === 'pdhClub') {
    return (
      <button
        type="button"
        data-badge-tooltip
        class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group text-left w-fit"
      >
        {badgeText}
        <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
          {tooltips[lang].featured}
        </span>
      </button>
    );
  }

  return (
  
    <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50 w-fit">
      {badgeText}
    </span>
  );
})}

          </div>
        </div>

        <div class="hidden lg:flex lg:flex-row lg:items-start gap-6 mb-6">
          <div class="flex-shrink-0">
            <img src={deal.logoimage} alt={deal.logo} class="w-48 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-neutral-100 mb-4"> {introT}</h2>  
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm lg:text-base">
              <div>
                <span class="text-neutral-400">{labl[lang].club}</span>
                <span class="text-neutral-100 ml-2 font-medium">{deal.club}</span>
              </div>
              <div>
                <span class="text-neutral-400">{labl[lang].union}</span>
                <span class="text-neutral-100 ml-2 font-medium">{deal.union}</span>
              </div>
              <div>
                <span class="text-neutral-400">{labl[lang].geog}</span>
                <span class="text-neutral-100 ml-2 font-medium">{typeof deal.geo === 'string' ? deal.geo : deal.geo[lang]}</span>
              </div>
              <div>
                <span class="text-neutral-400">{labl[lang].platform}</span> 
                <span class="text-neutral-100 ml-2 font-medium">{deal.app}</span>
              </div>
              {deal.bonus && deal.bonus[lang] && (
                <div>
                  <span class="text-neutral-400">{labl[lang].bonusL}</span>
                  <span class="text-gold ml-2 font-medium">{deal.bonus[lang]}</span>
                </div>
              )}

              <div>
                <span class="inline-block px-2 py-1 rounded-lg font-semibold text-green-300 border border-green-400/60 bg-green-950/40 shadow-[0_0_10px_rgba(0,255,0,0.15)]">
  {labl[lang].upTo} {deal.rakeback}
</span>
              </div>
        

            </div>
          </div>
        </div>

        <div class="lg:hidden mb-6">
          <h2 class="text-xl font-bold text-neutral-100 mb-3">{introT}</h2> 
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <div>
              <span class="text-neutral-400">{labl[lang].club}</span>
              <span class="text-neutral-100 ml-2 font-medium">{deal.club}</span>
            </div>
            <div>
              <span class="text-neutral-400">{labl[lang].union}</span>
              <span class="text-neutral-100 ml-2 font-medium">{deal.union}</span>
            </div>
            <div>
              <span class="text-neutral-400">{labl[lang].geog}</span>
              <span class="text-neutral-100 ml-2 font-medium">{typeof deal.geo === 'string' ? deal.geo : deal.geo[lang]}</span>
            </div>
            <div>
              <span class="text-neutral-400">{labl[lang].platform}</span>
              <span class="text-neutral-100 ml-2 font-medium">{deal.app}</span>
            </div>


            {deal.bonus && deal.bonus[lang] && (
              <div>
                <span class="text-neutral-400">{labl[lang].bonusL}</span>
                <span class="text-gold ml-2 font-medium">{deal.bonus[lang]}</span>
              </div>
            )}
                          

                          <div>
                          
                <span class="inline-block px-2 py-1 rounded-lg font-semibold text-green-300 border border-green-400/60 bg-green-950/40 shadow-[0_0_10px_rgba(0,255,0,0.15)]">
  {labl[lang].upTo} {deal.rakeback}
</span>
              </div>
          </div>
        </div>

        <div class="hidden lg:flex flex-wrap gap-2 mb-6 relative">
                     {deal.badges?.map((badge) => {
 
  const badgeText = badgeLabels.ru[badge as keyof typeof badgeLabels.ru] || badge;
  


  if (badge === 'pdhClub') {
    return (
      <button
        type="button"
        data-badge-tooltip
        class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group text-left w-fit"
      >
        {badgeText}
        <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
          {tooltips[lang].featured}
        </span>
      </button>
    );
  }

  return (
  
    <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50 w-fit">
      {badgeText}
    </span>
  );
})}
        </div>

        <button
          id="ctaButton"
          class="w-full sm:w-auto px-8 py-4 bg-gold text-neutral-900 rounded-xl font-bold text-lg hover:bg-gold-light transition-all mb-6"
        >
           {labl[lang].getDeal}
        </button>

        <h3 class="text-xl font-bold text-neutral-100 mb-3"> {labl[lang].rateBy} </h3>

        <div class="flex flex-wrap gap-6 items-center mb-4">
  <div class="flex items-center gap-2">
    <span class="text-neutral-400 text-sm">MTT</span>
    <span class="text-gold text-lg">{renderStars(deal.ratings.mtt)}</span>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-neutral-400 text-sm">PLO</span>
    <span class="text-gold text-lg">{renderStars(deal.ratings.plo)}</span>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-neutral-400 text-sm">NLH</span>
    <span class="text-gold text-lg">{renderStars(deal.ratings.nlh)}</span>
  </div>
</div>

<div class="prose prose-invert max-w-none mb-8 space-y-6">
  <div>
    <h3 class="text-xl font-bold text-neutral-100 mb-3">About 888Poker</h3> <!-- ✅ correction here -->
    <p class="text-neutral-300 leading-relaxed mb-4">
      888poker is one of the oldest and most reliable online poker rooms, owned by the publicly traded company 888 Holdings. It operates under licenses from the UK, Gibraltar, and other regulated jurisdictions, making it a safe choice for players who value legal protection and transparent payouts.
    </p>
    <p class="text-neutral-300 leading-relaxed mb-4">
      The room targets a broad audience with plenty of recreational players, a simple and intuitive app, and regular promotions and missions. The games are soft, especially at lower stakes. Rakeback is relatively modest — around 10–20% — but it’s balanced by weak opponents and stable bonus programs.
    </p>
    <p class="text-neutral-300 leading-relaxed mb-4">
      Unlike crypto rooms such as CoinPoker, 888poker uses only fiat deposits and a fully centralized system, ideal for players who prefer classic, regulated online poker without the risks of anonymous clubs.
    </p>
  </div>
</div>





<style>
ul.custom-bullets {
  list-style: none;
  padding-left: 0;
  margin: 0;
}

ul.custom-bullets li {
  position: relative;
  padding-left: 1.5em; /* отступ под текст */
  margin-bottom: 0.6em; /* немного воздуха между строками */
  line-height: 1.5;
}

ul.custom-bullets li::before {
  content: "•"; /* сама точка */
  position: absolute;
  left: 0;
  color: #e6b347; /* золотой цвет */
  font-weight: bold;
  font-size: 1.2em;
  line-height: 1;
  top: 0.15em; /* выравнивание по вертикали */
}
</style>

<div>
  <h3 class="text-xl font-bold text-neutral-100 mb-3">About the Deal</h3> <!-- ✅ correction here -->
  <p class="text-neutral-300 leading-relaxed mb-2">
    By registering through our link, you get:
  </p>
  <ul class="custom-bullets">
    <li><strong class="text-gold">Dynamic rakeback {deal.fixrb}</strong> — the more you play, the higher your rakeback.</li>
    <li><strong class="text-green-400">$88 no-deposit bonus</strong> — claim your bonus and start playing right away.</li>
  </ul>

  <p class="text-neutral-300 leading-relaxed mb-2">
    Register on 888Poker 
    <a href="https://ic.aff-handler.com/C/47431?sr=1851781&anid=10997111" 
       rel="nofollow noopener noreferrer" 
       target="_blank" 
       class="text-gold hover:text-gold-light underline underline-offset-2">
       through this link
    </a> 
    to take advantage of all the bonuses and benefits!
  </p>
</div>

            
          
          
          
          <div class="flex items-start gap-3 mb-4 mt-8 text-neutral-300 leading-relaxed">
 <div class="flex items-center gap-3 mb-4 text-neutral-300 leading-relaxed">
  <img
    src="/pdh_verif.webp"
    alt="PDH Verified"
    class="w-[68px] h-[68px] flex-shrink-0 select-none translate-y-[2px]"
    loading="lazy"
  />


  <p>
    {labl[lang].verif}
</div>


          </div>

          

          <div id="contactSection" class="bg-gold/10 border border-gold/30 rounded-xl p-6 text-center">
            <h3 class="text-2xl font-bold text-gold mb-3">{labl[lang].readyJoin}</h3>
            <p class="text-neutral-300 mb-6">{labl[lang].weAreHereNoKyc} <br>{labl[lang].weAreHere2}</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="https://t.me/pokerdealshub"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#0088cc] text-white rounded-xl font-bold text-lg hover:bg-[#006699] transition-colors"
