---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FilterSidebar from "../../../components/FilterSidebar.astro";
import DealsList from "../../../components/DealsList.astro";
import filterContent from "../../../data/filterContent.json";
import { dealsConfig } from "../../../config/dealsConfig.js";

export function getStaticPaths() {
  const totalPages = Math.ceil(dealsConfig.totalDeals / dealsConfig.perPage);
  return Array.from({ length: totalPages }).map((_, i) => ({
    params: { page: String(i + 1) },
    props: { currentPage: i + 1 },
  }));
}

const { currentPage = 1 } = Astro.props;
const lang = "en";
const content = filterContent.en.all;
---

<BaseLayout
  title={`${content.title} — Page ${currentPage}`}
  description={content.description}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-3 lg:pt-12 lg:pb-6">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
      <FilterSidebar />

      <div class="flex-1 min-w-0">
        {currentPage === 1 && (
          <div class="mb-6 lg:mb-8">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-3 lg:mb-4">
              {content.h1}
            </h1>
            {content.intro && (
              <div
                class="text-neutral-300 text-base lg:text-lg leading-relaxed mt-4
                       [&_a]:text-gold [&_a]:underline [&_a:hover]:text-gold-light [&_a:hover]:underline-offset-2
                       [&_p]:mb-6 [&_ul]:mb-6 [&_li]:mb-2
                       [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-bold [&_h2]:text-neutral-100 [&_h2]:mt-8 [&_h2]:mb-4
                       [&_strong]:text-neutral-100"
                set:html={content.intro}
              ></div>
            )}
          </div>
        )}

        <DealsList
          currentPage={currentPage - 1}
          perPage={dealsConfig.perPage}
          lang={lang}
        />

        {currentPage === 1 && (
          <div class="bg-neutral-900 border border-neutral-800 rounded-xl px-6 pt-0 pb-6 lg:px-8 lg:pt-0 lg:pb-8 mt-8">
            <div
              class="text-neutral-300 text-base leading-relaxed
                     [&_a]:text-gold [&_a]:underline [&_a:hover]:text-gold-light [&_a:hover]:underline-offset-2
                     [&_p]:mb-6 [&_ul]:mb-6 [&_li]:mb-2
                     [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-bold [&_h2]:text-neutral-100 [&_h2]:mt-8 [&_h2]:mb-4
                     [&_strong]:text-neutral-100"
              set:html={content.seoText}
            ></div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
