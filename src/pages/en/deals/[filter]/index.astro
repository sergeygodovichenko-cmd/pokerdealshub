---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import FilterSidebar from "../../../../components/FilterSidebar.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import DealsList from "../../../../components/DealsList.astro";
import deals from "../../../../data/deals.json";
import filterContent from "../../../../data/filterContent.json";
import { getLangFromUrl } from "../../../../i18n/utils";
import { dealsConfig } from "../../../../config/dealsConfig.js";
import { filterDeals } from "../../../../utils/filterDeals.js"; // ✅ новый импорт

// 🔹 Определяем язык и фильтр из URL
const lang = getLangFromUrl(Astro.url) || "en";
const { filter } = Astro.params;
const content = filterContent?.[lang]?.[filter];

// 🔹 Генерация статических путей (обязательно для динамических маршрутов)
export async function getStaticPaths() {
  const filters = [
    "pppoker", "clubgg", "xpoker", "pokerbros", "nutspoker", "coinpoker", "888poker",
    "centralized", "decentralized",
    "nuts-primetime", "massiv-union", "eldorado", "paradise", "blacksea", "pppfish", "rake2high",
    "europe", "asia", "cis", "australia", "america", "latam",
    "mtt", "nlh", "plo",
  ];

  return filters.map((filter) => ({
    params: { filter },
  }));
}

// 🔹 Фильтрация и сортировка (один источник правды)
const filteredDeals = filterDeals(deals, filter, lang);
const sortedDeals = [...filteredDeals].sort(dealsConfig.sortDeals);

// 🔹 Хлебные крошки
const breadcrumbs = [
  { name: lang === "ru" ? "Все сделки" : "All Deals", url: `/${lang}/deals/` },
  { name: content?.title || filter, url: `/${lang}/deals/${filter}/` },
];
---

<BaseLayout
  title={content?.title || `${filter} Poker Deals`}
  description={content?.description || ""}
  breadcrumbs={breadcrumbs}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-8 lg:pt-12 lg:pb-12">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
      <FilterSidebar currentFilter={filter} />

      <div class="flex-1 min-w-0">
        <Breadcrumbs items={breadcrumbs} />

        <div class="mb-6 lg:mb-8">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-3 lg:mb-4">
            {content?.h1 || content?.title || `${filter}`}
          </h1>
          {content?.intro && (
            <div
              class="text-neutral-300 text-base leading-relaxed mt-4
                     [&_a]:text-gold [&_a]:underline [&_a:hover]:text-gold-light [&_a:hover]:underline-offset-2
                     [&_p]:mb-6"
              set:html={content.intro}
            ></div>
          )}
        </div>

        <!-- 🔹 Первая страница списка сделок -->
        <DealsList
          lang={lang}
          dealsOverride={sortedDeals}
          filter={filter}
          currentPage={dealsConfig.defaultPage}
          perPage={dealsConfig.perPage}
        />

        <!-- 🔹 SEO-блок -->
        {content?.seoText && (
          <div class="bg-neutral-900 border border-neutral-800 rounded-xl px-6 pt-0 pb-6 lg:px-8 lg:pt-0 lg:pb-8">
            <div
              class="text-neutral-300 text-base leading-relaxed
                     [&_a]:text-gold [&_a]:underline [&_a:hover]:text-gold-light [&_a:hover]:underline-offset-2
                     [&_p]:mb-6 [&_ul]:mb-6 [&_li]:mb-2
                     [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-bold [&_h2]:text-neutral-100 [&_h2]:mt-8 [&_h2]:mb-4
                     [&_strong]:text-neutral-100"
              set:html={content.seoText}
            ></div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
