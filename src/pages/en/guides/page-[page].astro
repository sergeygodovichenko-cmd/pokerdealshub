---
import GuidesPageBase from "../../templates/GuidesPageBase.astro";
import guides from "../../../data/guides.json";
import { dealsConfig } from "../../../config/dealsConfig.js";

export function getStaticPaths() {
  const totalPages = Math.ceil(guides.length / dealsConfig.perPage);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i.toString() },
    props: { currentPage: i },
  }));
}
---

<GuidesPageBase lang="ru" currentPage={Astro.props.currentPage} />
