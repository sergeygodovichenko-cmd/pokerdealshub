---
import BaseLayout from '../../layouts/BaseLayout.astro';
import dealsData from '../../data/deals.json';

const telegramLink = 'https://t.me/pokerdealshub?text=Hello!%20I%20want%20to%20choose%20a%20deal';

const deals = [
  { title: 'Deal in “Nuts” on PPPoker', desc: 'Soft fields, steady action, and great terms for regular players.', slug: 'nuts-primetime-pppoker' },
  { title: 'Deal in Black Sea on X-Poker', desc: 'Plenty of action, multiple stakes, and comfy games for cash and MTT.', slug: 'blacksea-xpoker' },
  { title: 'Deal in “Dorado” on PPPoker', desc: 'Good traffic, playable fields, and a pleasant rakeback setup.', slug: 'eldorado-pppoker' },
  { title: 'Deal in Massiv on ClubGG', desc: 'Great for grinders and recs alike. Flexible stakes and a smooth game structure.', slug: 'massiv-clubgg' },
];

const appLogos = {
  pppoker: '/pppoker_logo.webp',
  'x-poker': '/xpoker_logo.webp',
  clubgg: '/clubGG_logo.webp',
  pokerbros: '/pokerbros_logo.webp',
};

const pickLogo = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('x-poker')) return appLogos['x-poker'];
  if (t.includes('clubgg')) return appLogos.clubgg;
  if (t.includes('pokerbros')) return appLogos.pokerbros;
  if (t.includes('pppoker')) return appLogos.pppoker;
  return '/chip.webp';
};

const pickAppLabel = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('x-poker')) return 'X-Poker';
  if (t.includes('clubgg')) return 'ClubGG';
  if (t.includes('pokerbros')) return 'PokerBros';
  if (t.includes('pppoker')) return 'PPPoker';
  return 'Poker';
};

const dealRakebackText = (slug: string) => {
  const found = dealsData.find((d) => d.slug === slug);
  if (found?.rakeback) return `Rakeback up to ${found.rakeback}`;
  return 'Rakeback up to 70%';
};

const steps = [
  { title: 'Download the app', desc: 'Install PPPoker, X-Poker, ClubGG or PokerBros on your smartphone.', icon: 'download' },
  { title: 'Register an account', desc: 'Create an account in the app. If anything is unclear — we’ll guide you.', icon: 'user' },
  { title: 'Join a club and play', desc: 'We’ll give you the club ID and instructions. Deposit and take your seat.', icon: 'chat' },
];

const faq = [
  {
    q: 'How do I pick the right club?',
    a: 'Choose a club with plenty of action in your format: cash, MTT, spins, etc. Focus on rakeback and deal terms — that’s your long-term profit. We’ll match a club to your stakes, format, and timezone.',
  },
  {
    q: 'How do I download the app?',
    a: 'Get the apps from the App Store / Google Play or the official sites. If access is restricted in your region, we’ll share fresh links and installation tips.',
  },
  {
    q: 'How do I make a deposit?',
    a: 'We accept USDT, USDC, BTC, plus fiat: UAH, RUB, EUR, USD, UZS. We’ll pick a convenient method and walk you through it.',
  },
  {
    q: 'How do I withdraw my winnings?',
    a: 'Payouts go in the same currency as your deposit: USDT, USDC, BTC, UAH, RUB, EUR, USD, UZS. Most withdrawals take up to 15 minutes after confirmation.',
  },
  {
    q: 'What is rakeback?',
    a: 'Rooms take a commission (rake) from every pot. Rakeback returns part of that commission. Example: you generate 100 units of rake and your deal is 50% rakeback — 50 units come back as cash or bonuses. The higher the rakeback, the easier it is to stay profitable over distance.',
  },
];
---

<BaseLayout
  title="Mobile poker with value — PokerDealsHub"
  description="Up to 70% rakeback, soft fields, and trusted clubs. We’ll match you with a club in PPPoker, X-Poker, ClubGG, or PokerBros."
>
  <div class="playpoker-page bg-neutral-950 text-neutral-100">
    <section class="w-full pt-0 lg:pt-0 pb-12 lg:pb-16 flex flex-col gap-6 lg:gap-10 lg:grid lg:grid-cols-2 lg:items-center">
      <div class="hero-frame order-1 lg:order-2 w-full">
        <img
          src="/hero_banner.webp"
          alt="Mobile poker with PDH"
          class="hero-img"
          loading="eager"
        />
      </div>

      <div class="flex flex-col order-2 lg:order-1 max-w-2xl space-y-6 px-4 md:px-6">
        <div class="space-y-4">
          <h1 class="text-3xl md:text-5xl font-bold leading-tight text-gold drop-shadow-[0_0_24px_rgba(0,0,0,0.45)]">
            Play mobile poker on the best terms
          </h1>
        </div>
        <ul class="space-y-2 text-neutral-200">
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Up to 70% rakeback</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Fishy games with live action</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Verified poker unions and clubs</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Personal manager and support 24/7</li>
        </ul>

        <div class="space-y-2">
          <p class="text-sm uppercase tracking-wide text-neutral-400">We play on all top platforms:</p>
          <div class="app-row">
            <img src="/pppoker_logo.webp" alt="PPPoker" class="app-logo" loading="lazy" />
            <img src="/xpoker_logo.webp" alt="X-Poker" class="app-logo" loading="lazy" />
            <img src="/clubGG_logo.webp" alt="ClubGG" class="app-logo" loading="lazy" />
            <img src="/pokerbros_logo.webp" alt="PokerBros" class="app-logo" loading="lazy" />
          </div>
        </div>

        <div class="flex flex-row items-center gap-3 flex-wrap">
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20 shrink-0"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Play poker
        </a>
          <p class="text-sm text-neutral-400 leading-snug">Message us and we’ll pick the optimal club for your stakes and format.</p>
        </div>

      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mb-8"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16" id="deals">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gold">Best offers for online poker</h2>
          <p class="text-neutral-300">Choose your format — we’ll secure the terms and rakeback.</p>
        </div>
      </div>

      <div class="grid gap-4">
        {deals.map((deal) => (
          <a
            href={`/en/deal/${deal.slug}/`}
            class="block group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/70 rounded-xl"
          >
            <article class="bg-neutral-900/40 border border-neutral-800 rounded-xl p-4 hover:border-gold/60 transition-all group-hover:border-gold/60">
              <div class="flex items-center gap-4 mb-3">
                <img
                  src={pickLogo(deal.title)}
                  alt={pickAppLabel(deal.title)}
                  class="w-14 h-14 object-cover rounded-xl border border-neutral-700/60 shadow-[0_0_0_1px_rgba(255,255,255,0.08)]"
                  loading="lazy"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-xs uppercase tracking-wide text-neutral-400">{pickAppLabel(deal.title)}</p>
                  <h3 class="text-lg font-semibold text-gold leading-snug line-clamp-2 group-hover:text-gold-light transition-colors">
                    {deal.title}
                  </h3>
                  <span class="deal-rake-badge">
                    {dealRakebackText(deal.slug)}
                  </span>
                </div>
              </div>
              <p class="text-neutral-300 text-sm leading-relaxed line-clamp-3">{deal.desc}</p>
            </article>
          </a>
        ))}
      </div>
      <div class="mt-8 pl-3">
        <a
          href="/en/deals/"
          class="text-gold hover:text-gold-light underline-offset-4 hover:underline font-semibold"
        >
          View all deals
        </a>
      </div>

      <div class="mt-6 space-y-3">
        <p class="text-neutral-300">
          And many more deals! Message us and we’ll pick the best option for your bankroll, format, and goals.
        </p>
        <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20 mt-2 mb-4"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Get rakeback
        </a>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16">
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gold">How to start playing</h2>
          <p class="text-neutral-300">3 simple steps to your first hands</p>
        </div>
        <div class="space-y-6 md:space-y-7">
          {steps.map((step, idx) => (
            <div class="flex items-start gap-4 p-4 md:p-5 bg-neutral-900/80 border border-neutral-800 rounded-xl transition duration-200 hover:border-gold/60 hover:-translate-y-0.5">
              <div class="text-gold font-semibold text-3xl md:text-4xl leading-none w-10 text-center">
                {String(idx + 1).padStart(2, '0')}
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-gold text-neutral-900 flex items-center justify-center shadow-md shadow-gold/30">
                  {step.icon === 'download' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v9m0 0 3.5-3.5M12 13 8.5 9.5M5 19h14" />
                    </svg>
                  )}
                  {step.icon === 'user' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 13a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-6 6a6 6 0 0 1 12 0" />
                    </svg>
                  )}
                  {step.icon === 'chat' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8.5 8.5 0 0 1-1.4 4.6 1 1 0 0 0-.16.51v3.02a.5.5 0 0 1-.8.4l-2.25-1.7a1 1 0 0 0-.6-.2H9a6 6 0 1 1 0-12h6a6 6 0 0 1 6 6Z" />
                    </svg>
                  )}
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-semibold text-gold">{step.title}</h3>
                  <p class="text-neutral-300 text-sm md:text-base leading-relaxed">{step.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="text-neutral-300">
          Don’t want to figure it out yourself? Message our manager — we’ll guide you from install to first hand.
        </div>
        <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Start playing
        </a>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="py-12 lg:py-14 bg-neutral-950">
      <div class="container mx-auto px-4 md:px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gold mb-8">Why players choose PokerDealsHub</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 text-neutral-300 max-w-5xl mx-auto">
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/shield.webp" alt="Verified clubs" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Verified unions</h3>
            <p class="leading-relaxed">We list only trusted clubs with real payouts and solid reputations.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/percent.webp" alt="Honest rakeback" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Honest rakeback</h3>
            <p class="leading-relaxed">Full transparency — you always know exactly how much you get back.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/chat.webp" alt="Support 24/7" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Support 24/7</h3>
            <p class="leading-relaxed">We’re online every day to help with setup, deposits, cashouts, and questions.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/fish.webp" alt="Soft games" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Soft action</h3>
            <p class="leading-relaxed">We match you with lively games and fishy tables right away.</p>
          </div>
        </div>
        <div class="mt-8 flex justify-center">
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
          >
            <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
            Message manager
          </a>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16">
      <div class="space-y-6">
        <h2 class="text-2xl md:text-3xl font-bold text-gold">Questions and answers</h2>
        <div class="flex flex-col gap-4">
          {faq.map((item) => (
            <details class="group bg-neutral-900/90 border border-neutral-800 rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.35)] transition-colors transition-transform duration-200 hover:border-gold/60 hover:-translate-y-0.5 hover:bg-neutral-900/70">
              <summary class="cursor-pointer flex items-center justify-between gap-4 p-4 md:p-5 text-lg font-semibold text-gold">
                {item.q}
                <span class="text-gold transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="px-4 md:px-5 pb-4 md:pb-5">
                <p class="text-neutral-300 text-sm md:text-base leading-relaxed">
                  {item.a}
                </p>
              </div>
            </details>
          ))}
        </div>
        <div class="mt-6 space-y-3">
          <p class="text-neutral-300 text-base leading-relaxed">
            Still have questions? Our team will gladly help you and get you playing in the best club.
          </p>
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
          >
            <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
            Ask a question
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .hero-frame {
      max-width: 620px;
      width: 100%;
    }
    .hero-img {
      width: 100%;
      height: auto;
      object-fit: contain;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .app-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      width: 100%;
      max-width: 100%;
      justify-items: center;
      align-items: center;
    }
    .app-logo {
      width: 80px;
      height: 80px;
      object-fit: contain;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
      background: #0b0b0b;
    }
    @media (min-width: 640px) {
      .app-row {
        gap: 10px;
      }
      .app-logo {
        width: 88px;
        height: 88px;
        border-radius: 12px;
      }
    }
    @media (min-width: 1024px) {
      .hero-frame {
        aspect-ratio: 5 / 6;
      }
      .hero-img {
        height: 100%;
        object-fit: cover;
      }
    }
    .deal-rake-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 10px;
      border: 1px solid rgba(74, 222, 128, 0.7);
      color: #4ade80;
      background: rgba(16, 185, 129, 0.18);
      border-radius: 9999px;
      font-weight: 600;
      font-size: 12px;
      line-height: 1;
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
    }
  </style>
</BaseLayout>
