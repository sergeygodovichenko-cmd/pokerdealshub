---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealCard from '../../components/DealCard.astro';
import FilterSidebar from '../../components/FilterSidebar.astro';
import deals from '../../data/deals.json';
import filterContent from '../../data/filterContent.json';
import { getLangFromUrl } from '../../i18n/utils';
const content = filterContent.es.all;
---

<BaseLayout
  title="PokerDealsHub — Mejores ofertas de póker, clubes y rakeback"
  description="Encuentra clubes y uniones de póker confiables en PPPoker, ClubGG y X-Poker. Disfruta de las mejores condiciones, rakeback alto y soporte 24/7."
  ogImage="/hero_wide_screen_top.webp"
>

  <!-- 🔸 мгновенный редирект -->
  <script is:inline>
    window.location.replace(window.location.pathname + 'deals/');
  </script>

  <!-- fallback если JS отключен -->
  <noscript>
    <meta http-equiv="refresh" content="0; url=deals/" />
  </noscript>

  <!-- предотвращает мигание неоформленного контента -->
  <style>
    html, body {
      background-color: #0a0a0a;
      color: transparent;
      overflow: hidden;
    }
  </style>

  <!-- 🔹 оригинальный контент сохранён полностью -->
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gold mb-6">
        PokerDealsHub — las mejores ofertas y clubes de póker en línea
      </h1>
      <p>
        PokerDealsHub es un directorio de clubes y uniones de póker verificados
        en aplicaciones populares como PPPoker, ClubGG y X-Poker.
        Ofrecemos las mejores condiciones, un rakeback justo
        y soporte diario para jugadores de todo el mundo.
      </p>
      <p>
        Encuentra el lugar perfecto para jugar, compara ofertas
        y elige un club con mesas suaves y pagos transparentes.
        PokerDealsHub te ayuda a jugar de forma rentable y segura.
      </p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const heroButton = document.getElementById('hero-banner');
      const dealsSection = document.getElementById('deals-section');

      if (heroButton && dealsSection) {
        heroButton.addEventListener('click', () => {
          const headerHeight = document.querySelector('header')?.offsetHeight || 0;
          const elementPosition = dealsSection.getBoundingClientRect().top + window.scrollY;
          const offsetPosition = elementPosition - headerHeight - 16;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        });
      }
    });
  </script>

  <style>
    .hero-banner-container {
      position: relative;
      width: 100%;
    }

    .hero-banner-top {
      position: relative;
      overflow: hidden;
      border-radius: 0.75rem 0.75rem 0 0;
      aspect-ratio: 1828 / 236;
    }

    @media (max-width: 639px) {
      .hero-banner-top {
        aspect-ratio: 993 / 417;
      }
    }

    .hero-banner-top::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.2) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      transform: skewX(-20deg);
      animation: shimmer 7s ease-in-out infinite;
      pointer-events: none;
      will-change: transform;
      mask-image: var(--shimmer-mask);
      -webkit-mask-image: var(--shimmer-mask);
      mask-size: contain;
      -webkit-mask-size: contain;
      mask-repeat: no-repeat;
      -webkit-mask-repeat: no-repeat;
    }

    @keyframes shimmer {
      0% { left: -100%; }
      20% { left: 100%; }
      100% { left: 100%; }
    }

    .hero-banner-arrows {
      position: relative;
      background: transparent;
      padding: 1rem 0;
      border-radius: 0 0 0.75rem 0.75rem;
      overflow: hidden;
    }

    .arrows-container {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      width: 100%;
    }

    .arrow {
      width: 32px;
      height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.3));
      position: absolute;
    }

    .arrow-left {
      left: 17%;
      animation: arrowBounce 2.5s ease-in-out infinite;
    }

    .arrow-center {
      animation: arrowBounce 2.5s ease-in-out infinite;
      transform: scale(1.2);
      position: relative;
    }

    .arrow-right {
      right: 17%;
      animation: arrowBounce 2.5s ease-in-out infinite;
    }

    @keyframes arrowBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-banner-top::after,
      .arrow-left,
      .arrow-center,
      .arrow-right {
        animation: none;
      }
    }

    @media (max-width: 639px) {
      .arrow {
        width: 32px;
        height: 32px;
      }
      .arrows-container {
        gap: 1rem;
      }
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    'itemListElement': deals.map((deal, index) => ({
      '@type': 'ListItem',
      'position': index + 1,
      'item': {
        '@type': 'Offer',
        'name': deal.name.es,
        'description': deal.description.es,
        'url': `https://pokerdealshub.com/es/deal/${deal.slug}/`,
      },
    })),
  })} />
</BaseLayout>
