---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedDeals from '../../../components/RelatedDeals.astro';
import { useTranslations } from '../../../i18n/utils';
import dealsData from '../../../data/deals.json';

const t = useTranslations('es');
const deal = dealsData.find(d => d.slug === 'pdh-nutspoker');

const badgeLabels = {
  pdhClub: '🔥 PDH club',
  pdhPartner: '🤝 PDH partner',
  centralized: '🏬 Centralized',
  soft: '🐟 Soft game',
  highRakeback: '💰 High Rakeback',
  verified: '✅ Verified',
  allLimits: '📊 All Limits',
  nonStop: '⏱ NonStop',
  international: '🌍 International'
};

const pdhTooltip = 'Club administrado por PokerDealsHub. Esto significa que obtendrás servicio al cliente de máxima calidad 24/7 y garantía completa de todas tus ganancias.';

const breadcrumbs = [
  { name: t('breadcrumb.home'), url: '/es/' },
  { name: t('breadcrumb.deals'), url: '/es/' },
  { name: 'Oferta en NUTS POKER con Rakeback de PHD', url: '/es/deal/pdh-nutspoker/' },
];
---

<BaseLayout
  title="Oferta de Póker en NUTS POKER con Rakeback de PHD — PokerDealsHub"
  description="Oferta en NUTS POKER con caja centralizada y procesamiento automatizado, hasta 50% de rakeback de PDH."
  breadcrumbs={breadcrumbs}
>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-5xl mx-auto">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-6">
        Oferta de Póker en NUTS POKER con Rakeback de PHD
      </h1>

      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 lg:p-8 mb-8">
        <div class="flex gap-4 mb-6 lg:hidden">
          <div class="flex-shrink-0">
            <img src="/nuts_poker_logo.webp" alt="Nuts Poker" class="w-32 sm:w-40 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex flex-col gap-2">
            {deal?.badges?.map((badge: string) => {
              const badgeText = badgeLabels[badge as keyof typeof badgeLabels];

              if (badge === 'pdhClub') {
                return (
                  <button
                    type="button"
                    data-badge-tooltip
                    class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group text-left w-fit"
                  >
                    {badgeText}
                    <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
                      {pdhTooltip}
                    </span>
                  </button>
                );
              }

              if (badge === 'pdhPartner') {
                return (
                  <span class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 w-fit">
                    {badgeText}
                  </span>
                );
              }

              return (
                <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50 w-fit">
                  {badgeText}
                </span>
              );
            })}
          </div>
        </div>

        <div class="hidden lg:flex lg:flex-row lg:items-start gap-6 mb-6">
          <div class="flex-shrink-0">
            <img src="/nuts_poker_logo.webp" alt="Nuts Poker" class="w-48 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-neutral-100 mb-4">Información sobre la Oferta en NUTS POKER</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm lg:text-base">
              <div>
                <span class="text-neutral-400">Club:</span>
                <span class="text-neutral-100 ml-2 font-medium">PDH Nuts Poker</span>
              </div>
              <div>
                <span class="text-neutral-400">Unión:</span>
                <span class="text-neutral-100 ml-2 font-medium">None</span>
              </div>
              <div>
                <span class="text-neutral-400">Geografía:</span>
                <span class="text-neutral-100 ml-2 font-medium">Asia, CEI</span>
              </div>
              <div>
                <span class="text-neutral-400">Plataforma:</span>
                <span class="text-neutral-100 ml-2 font-medium">Nuts poker</span>
              </div>
              <div>
                <span class="text-neutral-400">Rakeback:</span>
                <span class="text-gold ml-2 font-bold">hasta 50%</span>
              </div>
              <div>
                <span class="text-neutral-400">Bono:</span>
                <span class="text-green-400 ml-2 font-medium">hasta $1000 en el 1er depósito</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:hidden mb-6">
          <h2 class="text-xl font-bold text-neutral-100 mb-3">Condiciones de la Oferta en NUTS POKER</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <div>
              <span class="text-neutral-400">Club:</span>
              <span class="text-neutral-100 ml-2 font-medium">PDH Nuts Poker</span>
            </div>
            <div>
              <span class="text-neutral-400">Unión:</span>
              <span class="text-neutral-100 ml-2 font-medium">None</span>
            </div>
            <div>
              <span class="text-neutral-400">Geografía:</span>
              <span class="text-neutral-100 ml-2 font-medium">Asia, CEI</span>
            </div>
            <div>
              <span class="text-neutral-400">Plataforma:</span>
              <span class="text-neutral-100 ml-2 font-medium">Nuts poker</span>
            </div>
            <div>
              <span class="text-neutral-400">Rakeback:</span>
              <span class="text-gold ml-2 font-bold">hasta 50%</span>
            </div>
            <div>
              <span class="text-neutral-400">Bono:</span>
              <span class="text-green-400 ml-2 font-medium">hasta $1000 en el 1er depósito</span>
            </div>
          </div>
        </div>

        <div class="hidden lg:flex flex-wrap gap-2 mb-6 relative">
          {deal?.badges?.map((badge: string) => {
            const badgeText = badgeLabels[badge as keyof typeof badgeLabels];

            if (badge === 'pdhClub') {
              return (
                <button
                  type="button"
                  data-badge-tooltip
                  class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group"
                >
                  {badgeText}
                  <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
                    {pdhTooltip}
                  </span>
                </button>
              );
            }

            if (badge === 'pdhPartner') {
              return (
                <span class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30">
                  {badgeText}
                </span>
              );
            }

            return (
              <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50">
                {badgeText}
              </span>
            );
          })}
        </div>

        <button
          id="ctaButton"
          class="w-full sm:w-auto px-8 py-4 bg-gold text-neutral-900 rounded-xl font-bold text-lg hover:bg-gold-light transition-all mb-6"
        >
          Obtener la Oferta
        </button>

        <h3 class="text-xl font-bold text-neutral-100 mb-3">Calificaciones por Disciplina</h3>

        <div class="flex flex-wrap gap-6 items-center mb-4">
          <div class="flex items-center gap-2">
            <span class="text-neutral-400 text-sm">MTT</span>
            <span class="text-gold text-lg">★★★★☆</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-neutral-400 text-sm">PLO</span>
            <span class="text-gold text-lg">★★★★★</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-neutral-400 text-sm">NLH</span>
            <span class="text-gold text-lg">★★★★☆</span>
          </div>
        </div>

        <div class="prose prose-invert max-w-none mb-8 space-y-6">
          <div>
            <h3 class="text-xl font-bold text-neutral-100 mb-3">Descripción</h3>
            <p class="text-neutral-300 leading-relaxed">
              El Club PDH Nuts Poker es el club oficial de Poker Deals Hub en la aplicación de póker centralizada NUTS POKER. Es una aplicación PWA de póker con caja centralizada y procesamiento automático de depósitos/retiros que admite criptomonedas y monedas fiat. Muchos jugadores recreativos de Asia.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-neutral-100 mb-3">Sobre la Aplicación</h3>
            <p class="text-neutral-300 leading-relaxed">
              NUTS POKER es una aplicación de póker centralizada. Aunque tiene un sistema de clubes, los clubes solo se utilizan para asignar rakeback a los jugadores. Al mismo tiempo, todos los juegos se llevan a cabo en un pool común de jugadores. Los depósitos y retiros se procesan mediante procesamiento automatizado. La interfaz es lo más simple y conveniente posible: el juego comienza en un par de clics, las estadísticas y la caja están completamente integradas en el sistema, y el servicio de seguridad monitorea el juego las 24 horas.
            </p>
            <p class="text-neutral-300 leading-relaxed mb-4 mt-4">
              Características clave:
            </p>
            <ul class="list-disc list-inside text-neutral-300 space-y-2">
              <li>Soporte para todos los formatos populares — NLH, PLO4/5/6, MTT, SpinUp</li>
              <li>Clientes para iOS, Android y Windows</li>
              <li>Los juegos funcionan 24/7 en apuestas bajas y medias</li>
              <li>Promociones regulares y freerolls. ¡Garantía récord de freeroll – $36,000!</li>
            </ul>
          </div>

          <div>
            <h3 class="text-xl font-bold text-neutral-100 mb-3">Sobre la Oferta</h3>
            <p class="text-neutral-300 leading-relaxed mb-4">
              Los jugadores pueden elegir:
            </p>
            <ul class="list-disc list-inside text-neutral-300 space-y-2 mb-4">
              <li><strong class="text-green-400">Bono +100% en el primer depósito hasta $1000</strong> — acreditado en etapas.</li>
              <li><strong class="text-gold">Rakeback hasta 50%</strong> — sistema dinámico dependiendo del volumen de rake semanal.</li>
              <li><strong class="text-gold">RB fijo 30%</strong> — para nuevos jugadores.</li>
            </ul>
          </div>

          <div>
            <h3 class="text-xl font-bold text-neutral-100 mb-3">Depósitos y Retiros</h3>
            <ul class="list-disc list-inside text-neutral-300 space-y-2 mb-4">
              <li><strong>💵 Criptomoneda:</strong> USDT, BTC, ETH (en redes populares)</li>
              <li><strong>💳 Fiat:</strong> RUB, UAH, KZT, TJS, AZN, USD, EUR</li>
            </ul>
            <div class="bg-neutral-800/50 rounded-lg p-4 border border-neutral-700/50">
              <p class="text-neutral-300 space-y-1">
                <span class="flex items-center gap-2"><img src="/1-04.webp" alt="Ficha" class="w-[1.1em] h-[1.1em] inline-block" /> Precio de ficha: 1 ficha = 1 USD</span>
                <span class="flex items-center gap-2"><img src="/1-02.webp" alt="Depósito" class="w-[1.1em] h-[1.1em] inline-block" /> Depósito mínimo: $10</span>
                <span class="flex items-center gap-2"><img src="/1-03.webp" alt="Retiro" class="w-[1.1em] h-[1.1em] inline-block" /> Retiro mínimo: $10</span>
              </p>
            </div>
          </div>

          <div id="contactSection" class="bg-gold/10 border border-gold/30 rounded-xl p-6 text-center">
            <h3 class="text-2xl font-bold text-gold mb-3">¿Tienes preguntas? ¿Listo para unirte?</h3>
            <p class="text-neutral-300 mb-6">Contacta al gerente de PDH, trabajamos 24/7</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="https://t.me/pokerdealshub"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#0088cc] text-white rounded-xl font-bold text-lg hover:bg-[#006699] transition-colors"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.654-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
                </svg>
                Contactar en Telegram
              </a>
              <a
                href="https://wa.me/38267563945"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#25D366] text-white rounded-xl font-bold text-lg hover:bg-[#1da851] transition-colors"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                Contactar en WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-6">
    <RelatedDeals
      currentDealSlug={deal?.slug || ''}
      currentApp={deal?.app}
      currentGeo={deal?.geo}
      currentBadges={deal?.badges}
    />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Offer',
    'name': 'Oferta de Póker en NUTS POKER con Rakeback de PHD',
    'description': 'Oferta en NUTS POKER con caja centralizada y procesamiento automatizado, hasta 50% de rakeback de PDH.',
    'url': 'https://pokerdealshub.com/es/deal/pdh-nutspoker/',
    'category': 'Centralized',
    'itemOffered': {
      '@type': 'Service',
      'name': 'Nuts poker',
      'provider': {
        '@type': 'Organization',
        'name': 'PDH Nuts Poker',
      },
    },
  })} />

  <script>
    document.getElementById('ctaButton')?.addEventListener('click', () => {
      document.getElementById('contactSection')?.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    });
    function positionTooltips() {
      const badges = document.querySelectorAll('[data-badge-tooltip]');

      badges.forEach(badge => {
        const tooltip = badge.querySelector('.pdh-tooltip');
        if (!tooltip) return;

        const badgeRect = badge.getBoundingClientRect();
        const badgeCenterX = badgeRect.left + badgeRect.width / 2;
        const viewportWidth = window.innerWidth;
        const badgePositionPercent = (badgeCenterX / viewportWidth) * 100;

        tooltip.style.removeProperty('left');
        tooltip.style.removeProperty('right');
        tooltip.style.removeProperty('transform');

        if (badgePositionPercent >= 40 && badgePositionPercent <= 60) {
          tooltip.style.left = '50%';
          tooltip.style.transform = 'translateX(-50%)';
        } else if (badgePositionPercent < 40) {
          tooltip.style.left = '0';
        } else {
          tooltip.style.right = '0';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', positionTooltips);
    } else {
      positionTooltips();
    }

    window.addEventListener('resize', positionTooltips);

  </script>

</BaseLayout>
