---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedDeals from '../../../components/RelatedDeals.astro';
import dealsData from '../../../data/deals.json';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { badgeLabels, tooltips } from '../../../utils/dealHelpers';
import { labl } from '../../../utils/dealHelpers';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const deal = dealsData.find(d => d.slug === 'blacksea-xpoker');
if (!deal) {
  throw new Error('Deal not found: blacksea-xpoker');
}

const pdhTooltip = tooltips.es.featured;

const breadcrumbs = [
  { name: t('breadcrumb.deals'), url: `/${lang}/deals/` },
  { name: deal.name[lang], url: `/${lang}/deal/${deal.slug}/` },
];

const renderStars = (rating) => '★'.repeat(rating) + '☆'.repeat(5 - rating);
const introT = 'Información sobre la unión Black Sea';

const title = `Oferta de póker en la unión Black Sea en X-Poker — PokerDealsHub`;
const description = `Oferta de PDH en la unión Black Sea en X-Poker. Juego de alta calidad con excelentes condiciones para jugadores de la región CIS.`;

---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-5xl mx-auto">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-6">
        Oferta de rakeback en la unión Black Sea en X-Poker
      </h1>

      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 lg:p-8 mb-8">
        <div class="flex gap-4 mb-6 lg:hidden">
          <div class="flex-shrink-0">
            <img src={deal.logoimage} alt={deal.logoalt} class="w-32 sm:w-40 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex flex-col gap-2">
            {deal.badges?.map((badge) => {
              const badgeText = badgeLabels.es[badge as keyof typeof badgeLabels.es] || badge;

              if (badge === 'pdhClub') {
                return (
                  <button
                    type="button"
                    data-badge-tooltip
                    class="px-3 py-1.5 text-xs font-medium bg-gold/10 text-gold rounded-lg border border-gold/30 hover:bg-gold/20 transition-colors cursor-pointer relative group text-left w-fit"
                  >
                    {badgeText}
                    <span class="pdh-tooltip absolute top-full mt-2 w-72 p-4 bg-neutral-800 text-neutral-200 text-xs leading-relaxed rounded-lg border border-neutral-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none whitespace-normal z-10">
                      {tooltips[lang].featured}
                    </span>
                  </button>
                );
              }

              return (
                <span class="px-3 py-1.5 text-xs font-medium bg-neutral-800/80 text-neutral-200 rounded-lg border border-neutral-700/50 w-fit">
                  {badgeText}
                </span>
              );
            })}
          </div>
        </div>

        <div class="hidden lg:flex lg:flex-row lg:items-start gap-6 mb-6">
          <div class="flex-shrink-0">
            <img src={deal.logoimage} alt={deal.logoalt} class="w-48 h-auto object-contain rounded-xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-neutral-100 mb-4">{introT}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm lg:text-base">
              <div>
                <span class="text-neutral-400">{labl[lang].club}</span>
                <span class="text-neutral-100 ml-2 font-medium">{deal.club}</span>
              </div>
              <div>
                <span class="text-neutral-400">{labl[lang].union}</span>
                <span class="text-neutral-100 ml-2 font-medium">{deal.union}</span>
              </div>
              <div>
                <span class="text-neutral-400">{labl[lang].geog}</span>
                <span class="text-neutral-100 ml-2 font-medium">{typeof deal.geo === 'string' ? deal.geo : deal.geo[lang]}</span>
              </div>
              <div>
                <span class="text-neutral-400">{labl[lang].platform}</span>
                <span class="text-neutral-100 ml-2 font-medium">{deal.app}</span>
              </div>
              <div>
                <span class="inline-block px-2 py-1 rounded-lg font-semibold text-green-300 border border-green-400/60 bg-green-950/40 shadow-[0_0_10px_rgba(0,255,0,0.15)]">
                  {labl[lang].upTo} {deal.rakeback}
                </span>
              </div>
            </div>
          </div>
        </div>

        <h3 class="text-xl font-bold text-neutral-100 mb-3">Descripción</h3>
        <p class="text-neutral-300 leading-relaxed">
          Oferta de póker en el club PDH BlackSea, que forma parte de la gran unión CIS Black Sea en la plataforma X-Poker.
          El club pertenece a PokerDealsHub, lo que garantiza su seguridad y un servicio al cliente de primer nivel las 24 horas, todos los días.
        </p>

        <h3 class="text-xl font-bold text-neutral-100 mb-3 mt-6">Sobre la unión</h3>
        <p class="text-neutral-300 leading-relaxed">
          Black Sea es una unión popular en la plataforma X-Poker, especializada en jugadores de la región CIS.
          Ofrece una amplia variedad de mesas y formatos con un tráfico estable durante todo el día.
        </p>
        <p class="text-neutral-300 leading-relaxed">
          Disciplinas disponibles: MTT, NLH, OFC, PLO4/5/6, Short Deck(6+), así como variaciones Double Board y Bomb Pot.
          En cualquier momento del día puede encontrarse juego en todos los límites. El pico de actividad es de 14:00 a 22:00 GMT+3.
        </p>

        <h3 class="text-xl font-bold text-neutral-100 mb-3 mt-6">Sobre la oferta</h3>
        <p class="text-neutral-300 leading-relaxed mb-2">Los jugadores pueden elegir entre:</p>
        <ul class="custom-bullets">
          <li><strong class="text-gold">Rakeback dinámico hasta {deal.rakeback}</strong> — el porcentaje depende del volumen semanal de rake.</li>
          <li><strong class="text-gold">Rakeback fijo {deal.fixrb}</strong> — comience a jugar con una ventaja inmediata. Posteriormente puede cambiar al modelo dinámico.</li>
        </ul>

        <div class="mt-8">
          <p class="text-neutral-300 leading-relaxed">
            {labl[lang].verif}
          </p>
        </div>

        <div id="contactSection" class="bg-gold/10 border border-gold/30 rounded-xl p-6 text-center mt-8">
          <h3 class="text-2xl font-bold text-gold mb-3">{labl[lang].readyJoin}</h3>
          <p class="text-neutral-300 mb-6">{labl[lang].weAreHere} <br>{labl[lang].weAreHere2}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://t.me/pokerdealshub"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#0088cc] text-white rounded-xl font-bold text-lg hover:bg-[#006699] transition-colors"
            >
              Telegram
            </a>
            <a
              href="https://wa.me/38267563945"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#25D366] text-white rounded-xl font-bold text-lg hover:bg-[#1da851] transition-colors"
            >
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  
    <div class="container mx-auto px-4 py-6">
    <RelatedDeals
      currentDealSlug={deal?.slug || ''}
      currentApp={deal?.app}
      currentGeo={deal?.geo}
      currentBadges={deal?.badges}
    />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Offer',
    'name': title,
    'description': description,
    'url': `https://pokerdealshub.com/${lang}/deal/${deal.slug}`,
    'category': `${deal.type}`,
    'itemOffered': {
      '@type': 'Service',
      'name': `${deal.app}`,
      'provider': {
        '@type': 'Organization',
        'name': `${deal.union}`,
      },
    },
  })} />

  <script>
    document.getElementById('ctaButton')?.addEventListener('click', () => {
      document.getElementById('contactSection')?.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    });

    function positionTooltips() {
      const badges = document.querySelectorAll('[data-badge-tooltip]');

      badges.forEach(badge => {
        const tooltip = badge.querySelector('.pdh-tooltip');
        if (!tooltip) return;

        const badgeRect = badge.getBoundingClientRect();
        const badgeCenterX = badgeRect.left + badgeRect.width / 2;
        const viewportWidth = window.innerWidth;
        const badgePositionPercent = (badgeCenterX / viewportWidth) * 100;

        tooltip.style.removeProperty('left');
        tooltip.style.removeProperty('right');
        tooltip.style.removeProperty('transform');

        if (badgePositionPercent >= 40 && badgePositionPercent <= 60) {
          tooltip.style.left = '50%';
          tooltip.style.transform = 'translateX(-50%)';
        } else if (badgePositionPercent < 40) {
          tooltip.style.left = '0';
        } else {
          tooltip.style.right = '0';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', positionTooltips);
    } else {
      positionTooltips();
    }

    window.addEventListener('resize', positionTooltips);
  </script>
  
</BaseLayout>
