---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import guides from '../../../data/guides.json';

const t = useTranslations('es');
---

<BaseLayout
  title="Guías y Reseñas de Póker — PokerDealsHub"
  description="Guías detalladas y reseñas sobre aplicaciones de póker, uniones y ofertas de rakeback"
>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gold mb-6">
        {t('guides.title')}
      </h1>
      <p class="text-neutral-300 text-lg">
        {t('guides.subtitle')}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 gap-6">
        {guides.map((guide) => (
          <article class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 hover:border-gold transition-all group">
            <div class="flex items-start justify-between mb-3">
              <span class={`text-xs px-3 py-1 rounded-full ${
                guide.category === 'guide'
                  ? 'bg-blue-500/20 text-blue-400'
                  : 'bg-green-500/20 text-green-400'
              }`}>
                {guide.category === 'guide' ? 'Guía' : 'Reseña'}
              </span>
              <time class="text-sm text-neutral-500">
                {new Date(guide.date).toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </div>

            <h2 class="text-2xl font-semibold text-gold group-hover:text-gold-light transition-colors mb-3">
              <a href={`/es/guides/${guide.slug}/`}>
                {guide.title.es}
              </a>
            </h2>

            <p class="text-neutral-400 mb-4">
              {guide.description.es}
            </p>

            <a
              href={`/es/guides/${guide.slug}/`}
              class="inline-flex items-center text-gold hover:text-gold-light transition-colors text-sm font-medium"
            >
              Leer más
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-12 bg-neutral-900 border border-neutral-800 rounded-xl p-8">
        <h2 class="text-2xl font-semibold text-gold mb-4">Sobre la sección de guías</h2>
        <p class="text-neutral-300 mb-4">
          En esta sección publicamos guías y reseñas detalladas de aplicaciones de póquer, uniones y ofertas. Nuestro objetivo es ayudarte a entender las condiciones de juego y elegir la mejor opción.
        </p>
        <p class="text-neutral-300">
          Todas las guías se basan en experiencia real y en información verificada. Si tienes preguntas o quieres ver una guía sobre un tema concreto, <a href="/es/about/" class="text-gold hover:text-gold-light underline underline-offset-2 hover:decoration-gold-light"
>ponte en contacto con nosotros</a>.
        </p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    'itemListElement': guides.map((guide, index) => ({
      '@type': 'ListItem',
      'position': index + 1,
      'item': {
        '@type': 'Article',
        'headline': guide.title.es,
        'description': guide.description.es,
        'datePublished': guide.date,
        'url': `https://pokerdealshub.com/es/guides/${guide.slug}/`,
      },
    })),
  })} />
</BaseLayout>
