---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDeals } from '../../utils/deals';
const dealsData = await getDeals();

const telegramLink = 'https://t.me/pokerdealshub?text=Salom!%20Men%20bitim%20tanlamoqchiman';

const deals = [
  { title: '“Nuts” bitimi — PPPoker', desc: 'Yumshoq stollar, barqaror ekshen va reglar uchun foydali shartlar.', slug: 'nuts-primetime-pppoker' },
  { title: 'Black Sea bitimi — X-Poker', desc: 'Ko‘p ekshen, turli limitlar va kesh hamda MTT uchun qulay maydon.', slug: 'blacksea-xpoker' },
  { title: '“Dorado” bitimi — PPPoker', desc: 'Yaxshi trafik, o‘ynaladigan stollar va yoqimli rakebek sharti.', slug: 'eldorado-pppoker' },
  { title: 'Massiv bitimi — ClubGG', desc: 'Grind va rekreatsionlar uchun mos. Moslashuvchan limitlar va qulay o‘yin tuzilmasi.', slug: 'massiv-clubgg' },
];

const appLogos = {
  pppoker: '/pppoker_logo.webp',
  'x-poker': '/xpoker_logo.webp',
  clubgg: '/clubGG_logo.webp',
  pokerbros: '/pokerbros_logo.webp',
};

const pickLogo = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('x-poker')) return appLogos['x-poker'];
  if (t.includes('clubgg')) return appLogos.clubgg;
  if (t.includes('pokerbros')) return appLogos.pokerbros;
  if (t.includes('pppoker')) return appLogos.pppoker;
  return '/chip.webp';
};

const pickAppLabel = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('x-poker')) return 'X-Poker';
  if (t.includes('clubgg')) return 'ClubGG';
  if (t.includes('pokerbros')) return 'PokerBros';
  if (t.includes('pppoker')) return 'PPPoker';
  return 'Poker';
};

const dealRakebackText = (slug: string) => {
  const found = dealsData.find((d) => d.slug === slug);
  if (found?.rakeback) return `Rakebekga qadar ${found.rakeback}`;
  return 'Rakebekga qadar 70%';
};

const steps = [
  { title: 'Ilovani yuklab oling', desc: 'PPPoker, X-Poker, ClubGG yoki PokerBros-ni telefoningizga o‘rnating.', icon: 'download' },
  { title: 'Hisob yarating', desc: 'Akkount oching. Nima tushunarsiz bo‘lsa — ko‘rsatma beramiz.', icon: 'user' },
  { title: 'Klubga kiring va o‘ynang', desc: 'Klub ID va yo‘riqnoma beramiz. Depozit kiritib, stolga o‘tiring.', icon: 'chat' },
];

const faq = [
  {
    q: 'Qanday qilib to‘g‘ri klubni tanlash?',
    a: 'O‘zingiz yoqtirgan formatda (kesh, MTT va h.k.) ko‘p o‘yin bo‘lishi va rakebek foizi muhim — bu uzoq muddatli foydaning asosi. Limit, format va vaqt mintaqangizga mos klubni biz topamiz.',
  },
  {
    q: 'Ilovani qanday yuklab olish mumkin?',
    a: 'App Store / Google Play yoki rasmiy saytlardan. Mintaqangizda cheklov bo‘lsa, aktual havola va ko‘rsatmalarni beramiz.',
  },
  {
    q: 'Depozitni qanday qilish mumkin?',
    a: 'USDT, USDC, BTC va fiat: UAH, RUB, EUR, USD, UZS qabul qilamiz. Qulay usulni tanlab, bosqichma-bosqich yordam beramiz.',
  },
  {
    q: 'Yutug‘imni qanday yechaman?',
    a: 'Depozit valyutasida chiqaramiz: USDT, USDC, BTC, UAH, RUB, EUR, USD, UZS. Ko‘pincha tasdiqlangach 15 daqiqagacha davom etadi.',
  },
  {
    q: 'Rakebek nima?',
    a: 'Rake — har bir bankdan olinadigan komissiya. Rakebek uning bir qismini qaytaradi. Masalan: 100 rake to‘pladingiz, kelishuv 50% — 50 birlik pul yoki bonus sifatida qaytadi. Rakebek yuqori bo‘lsa, uzoq muddatda plusga chiqish osonlashadi.',
  },
];
---

<BaseLayout
  title="Maksimal foydali mobil poker — PokerDealsHub"
  description="70% gacha rakebek, yumshoq stollar va tekshirilgan klublar. PPPoker, X-Poker, ClubGG yoki PokerBros uchun klub topamiz."
>
  <div class="playpoker-page bg-neutral-950 text-neutral-100">
    <section class="container mx-auto px-4 py-12 lg:py-16 flex flex-col gap-6 lg:gap-10 lg:grid lg:grid-cols-2 lg:items-center">
      <div class="hero-frame order-1 lg:order-2 mx-auto w-full">
        <img
          src="/hero_banner.webp"
          alt="Mobil poker PDH bilan"
          class="hero-img"
          loading="eager"
        />
      </div>

      <div class="flex flex-col order-2 lg:order-1 max-w-2xl space-y-6">
        <div class="space-y-4">
          <h1 class="text-3xl md:text-5xl font-bold leading-tight text-gold drop-shadow-[0_0_24px_rgba(0,0,0,0.45)]">
            Mobil pokerni eng yaxshi shartlarda o‘ynang
          </h1>
        </div>
        <ul class="space-y-2 text-neutral-200">
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> 70% gacha rakebek</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Fişli stollar va jonli ekshen</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Tekshirilgan poker ittifoqlari va klublari</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Shaxsiy menejer va 24/7 qo‘llab-quvvatlash</li>
        </ul>

        <div class="flex flex-row items-center gap-3 flex-wrap">
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20 shrink-0"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Poker o‘ynash
        </a>
          <p class="text-sm text-neutral-400 leading-snug">Bizga yozing, limit va formatga mos klubni tanlab beramiz.</p>
        </div>

      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mb-8"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16" id="deals">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gold">Mobil poker uchun top bitimlar</h2>
          <p class="text-neutral-300">Formatni tanlang — shartlar va rakebekni biz ta’minlaymiz.</p>
        </div>
      </div>

      <div class="grid gap-4">
        {deals.map((deal) => (
          <a
            href={`/uz/deal/${deal.slug}/`}
            class="block group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/70 rounded-xl"
          >
            <article class="bg-neutral-900/40 border border-neutral-800 rounded-xl p-4 hover:border-gold/60 transition-all group-hover:border-gold/60">
              <div class="flex items-center gap-4 mb-3">
                <img
                  src={pickLogo(deal.title)}
                  alt={pickAppLabel(deal.title)}
                  class="w-14 h-14 object-cover rounded-xl border border-neutral-700/60 shadow-[0_0_0_1px_rgba(255,255,255,0.08)]"
                  loading="lazy"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-xs uppercase tracking-wide text-neutral-400">{pickAppLabel(deal.title)}</p>
                  <h3 class="text-lg font-semibold text-gold leading-snug line-clamp-2 group-hover:text-gold-light transition-colors">
                    {deal.title}
                  </h3>
                  <span class="deal-rake-badge">
                    {dealRakebackText(deal.slug)}
                  </span>
                </div>
              </div>
              <p class="text-neutral-300 text-sm leading-relaxed line-clamp-3">{deal.desc}</p>
            </article>
          </a>
        ))}
      </div>
      <div class="mt-8 pl-3">
        <a
          href="/uz/deals/"
          class="text-gold hover:text-gold-light underline-offset-4 hover:underline font-semibold"
        >
          Barcha bitimlar
        </a>
      </div>

      <div class="mt-6 space-y-3">
        <p class="text-neutral-300">
          Yana ko‘plab bitimlar bor! Bizga yozing — bankroll, format va maqsadingizga mos eng yaxshisini tanlaymiz.
        </p>
        <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20 mt-2 mb-4"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Rakebek olish
        </a>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16">
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gold">Qanday boshlash kerak</h2>
          <p class="text-neutral-300">3 qadamda birinchi qo‘llaringizga yeting</p>
        </div>
        <div class="space-y-6 md:space-y-7">
          {steps.map((step, idx) => (
            <div class="flex items-start gap-4 p-4 md:p-5 bg-neutral-900/80 border border-neutral-800 rounded-xl transition duration-200 hover:border-gold/60 hover:-translate-y-0.5">
              <div class="text-gold font-semibold text-3xl md:text-4xl leading-none w-10 text-center">
                {String(idx + 1).padStart(2, '0')}
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-gold text-neutral-900 flex items-center justify-center shadow-md shadow-gold/30">
                  {step.icon === 'download' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v9m0 0 3.5-3.5M12 13 8.5 9.5M5 19h14" />
                    </svg>
                  )}
                  {step.icon === 'user' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 13a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-6 6a6 6 0 0 1 12 0" />
                    </svg>
                  )}
                  {step.icon === 'chat' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8.5 8.5 0 0 1-1.4 4.6 1 1 0 0 0-.16.51v3.02a.5.5 0 0 1-.8.4l-2.25-1.7a1 1 0 0 0-.6-.2H9a6 6 0 1 1 0-12h6a6 6 0 0 1 6 6Z" />
                    </svg>
                  )}
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-semibold text-gold">{step.title}</h3>
                  <p class="text-neutral-300 text-sm md:text-base leading-relaxed">{step.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="text-neutral-300">
          O‘zingiz qilishni istamaysizmi? Shunchaki menejerga yozing — o‘rnatishdan birinchi qo‘lgacha yo‘l ko‘rsatamiz.
        </div>
        <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          O‘ynashni boshlash
        </a>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="py-12 lg:py-14 bg-neutral-950">
      <div class="container mx-auto px-4 md:px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gold mb-8">Nega o'yinchilar PokerDealsHub'ni tanlaydi</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 text-neutral-300 max-w-5xl mx-auto">
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/shield.webp" alt="Tekshirilgan klublar" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Tekshirilgan klublar</h3>
            <p class="leading-relaxed">Faqat haqiqiy to'lovlari va obro'si bor klublarni joylaymiz.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/percent.webp" alt="Halol rakebek" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Halol rakebek</h3>
            <p class="leading-relaxed">Hammasi ochiq — qancha qaytishini aniq bilib turasiz.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/chat.webp" alt="24/7 qo'llab-quvvatlash" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">24/7 qo'llab-quvvatlash</h3>
            <p class="leading-relaxed">Har kuni onlayn — o'rnatish, depozit, keshout va savollarda yordam beramiz.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/fish.webp" alt="Yumshoq maydonlar" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Yumshoq maydonlar</h3>
            <p class="leading-relaxed">Darrov jonli ekshenli, fishli stollarga ulab beramiz.</p>
          </div>
        </div>
        <div class="mt-8 flex justify-center">
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
          >
            <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
            Menejerga yozish
          </a>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="container mx-auto px-4 pb-16">
      <div class="space-y-6">
        <h2 class="text-2xl md:text-3xl font-bold text-gold">Savollar va javoblar</h2>
        <div class="flex flex-col gap-4">
          {faq.map((item) => (
            <details class="group bg-neutral-900/90 border border-neutral-800 rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.35)] transition-colors transition-transform duration-200 hover:border-gold/60 hover:-translate-y-0.5 hover:bg-neutral-900/70">
              <summary class="cursor-pointer flex items-center justify-between gap-4 p-4 md:p-5 text-lg font-semibold text-gold">
                {item.q}
                <span class="text-gold transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="px-4 md:px-5 pb-4 md:pb-5">
                <p class="text-neutral-300 text-sm md:text-base leading-relaxed">
                  {item.a}
                </p>
              </div>
            </details>
          ))}
        </div>
        <div class="mt-6 space-y-3">
          <p class="text-neutral-300 text-base leading-relaxed">
            Savollaringiz qoldimi? Jamoamiz mamnuniyat bilan yordam beradi va eng yaxshi klubda o‘ynashni boshlashga yo‘l-yo‘riq ko‘rsatadi.
          </p>
          <a
            href={telegramLink}
            target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Savol berish
        </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .hero-frame {
      max-width: 620px;
      width: 100%;
    }
    .hero-img {
      width: 100%;
      height: auto;
      object-fit: contain;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .app-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      width: 100%;
      max-width: 100%;
      justify-items: center;
      align-items: center;
    }
    .app-logo {
      width: 80px;
      height: 80px;
      object-fit: contain;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
      background: #0b0b0b;
    }
    @media (min-width: 640px) {
      .app-row {
        gap: 10px;
      }
      .app-logo {
        width: 88px;
        height: 88px;
        border-radius: 12px;
      }
    }
    @media (min-width: 1024px) {
      .hero-frame {
        aspect-ratio: 5 / 6;
      }
      .hero-img {
        height: 100%;
        object-fit: cover;
      }
    }
    .deal-rake-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 10px;
      border: 1px solid rgba(74, 222, 128, 0.7);
      color: #4ade80;
      background: rgba(16, 185, 129, 0.18);
      border-radius: 9999px;
      font-weight: 600;
      font-size: 12px;
      line-height: 1;
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
    }
  </style>
</BaseLayout>
