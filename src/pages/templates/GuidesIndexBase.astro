---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuidesList from "../../components/GuidesList.astro";
import guides from "../../data/guides.json";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url) || "ru";

const meta = {
  en: {
    title: "Poker Guides & Reviews — Strategy, Apps, Rakeback",
    description:
      "Practical, updated poker guides and reviews — learn about apps, rakeback and safety."
  },
  es: {
    title: "Guías y Reseñas de Póker — Estrategia, Apps, Rakeback",
    description:
      "Guías y reseñas prácticas de póker — conoce las apps, rakeback y seguridad."
  },
  ru: {
    title: "Гайды и обзоры — стратегия, приложения и рейкбэк",
    description:
      "Практичные гайды и обзоры по приложениям, союзам и рейкбэку."
  }
}[lang];
---

<BaseLayout title={meta.title} description={meta.description} ogImage="/hero_texture.webp">
  <section class="px-6 md:px-12 py-10 md:py-16">
    <header class="mb-8 md:mb-10">
      <h1 class="text-2xl md:text-3xl font-bold text-neutral-100">{meta.title}</h1>
      <p class="mt-2 text-neutral-300">{meta.description}</p>
    </header>

    <GuidesList guides={guides} lang={lang} basePath={lang === "en" ? "/en" : lang === "es" ? "/es" : ""} />
  </section>
</BaseLayout>
