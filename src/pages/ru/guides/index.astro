---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuidesList from "../../../components/GuidesList.astro";
import { getLangFromUrl } from "../../../i18n/utils";
import { dealsConfig } from "../../../config/dealsConfig.js";

const lang = getLangFromUrl(Astro.url) || "en";

let title = "";
let description = "";
let introHeading = "";
let introText = "";
let seoHeading = "";
let seoParagraphs = [];

switch (lang) {
  case "ru":
    title = "Гайды и статьи о покере | PokerDealsHub";
    description =
      "Подробные гайды о покерных приложениях, союзах, рейкбэк-сделках и стратегиях игры. Все статьи PokerDealsHub основаны на реальном опыте.";
    introHeading = "Гайды и статьи о покере";
    introText =
      "Мы публикуем гайды и обзоры по покерным приложениям, союзам и стратегиям. Здесь вы найдёте практические советы и проверенные источники.";
    seoHeading = "О чём эти гайды";
    seoParagraphs = [
      "PokerDealsHub публикует гайды и статьи, основанные на реальном опыте профессиональных игроков. Мы помогаем вам разобраться в особенностях разных покерных приложений, союзов и форматов игры.",
      "Здесь вы найдёте практические советы по выбору клуба, анализ рейкбэка, сравнение условий в популярных союзах, а также подробные обзоры турниров и кэш-игр."
    ];
    break;

  case "es":
    title = "Guías y artículos de póker | PokerDealsHub";
    description =
      "Guías detalladas sobre aplicaciones de póker, uniones, ofertas de rakeback y estrategias de juego. Todos los artículos de PokerDealsHub se basan en experiencia real.";
    introHeading = "Guías y artículos de póker";
    introText =
      "Publicamos guías y reseñas sobre aplicaciones de póker, uniones y estrategias. Aquí encontrarás consejos prácticos e información verificada.";
    seoHeading = "Sobre nuestras guías";
    seoParagraphs = [
      "PokerDealsHub publica guías y artículos basados en la experiencia real de jugadores profesionales.",
      "Aquí encontrarás consejos prácticos sobre la elección de clubes, análisis de rakeback y comparaciones de uniones populares."
    ];
    break;

  default:
    title = "Poker Guides and Articles | PokerDealsHub";
    description =
      "Detailed poker guides about apps, unions, rakeback deals and playing strategies. All PokerDealsHub articles are based on real experience.";
    introHeading = "Poker Guides and Articles";
    introText =
      "We publish guides and reviews about poker apps, unions and strategies. Here you’ll find practical advice and verified insights.";
    seoHeading = "About Our Poker Guides";
    seoParagraphs = [
      "PokerDealsHub publishes guides and articles based on real player experience. We help you understand different poker apps, unions and game formats.",
      "You’ll find practical advice on club selection, rakeback analysis, union comparisons, and detailed breakdowns of both tournaments and cash games."
    ];
    break;
}
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-8 lg:pt-12 lg:pb-12">
    <!-- Header -->
    <div class="mb-6 lg:mb-8 max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gold mb-3 lg:mb-4">
        {introHeading}
      </h1>
      <p class="text-neutral-300 text-base lg:text-lg leading-relaxed mt-4">
        {introText}
      </p>
    </div>

    <!-- Guides list with lazy loading -->
    <GuidesList
      currentPage={dealsConfig.defaultPage}
      perPage={dealsConfig.perPage}
      lang={lang}
    />

    <!-- SEO text -->
    <div class="bg-neutral-900 border border-neutral-800 rounded-xl px-6 pt-0 pb-6 lg:px-8 lg:pt-0 lg:pb-8 mt-8">
      <div
        class="text-neutral-300 text-base leading-relaxed
               [&_a]:text-gold [&_a]:underline [&_a:hover]:text-gold-light [&_a:hover]:underline-offset-2
               [&_p]:mb-6 [&_ul]:mb-6 [&_li]:mb-2
               [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-bold [&_h2]:text-neutral-100 [&_h2]:mt-8 [&_h2]:mb-4
               [&_strong]:text-neutral-100"
      >
        <h2>{seoHeading}</h2>
        {seoParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
