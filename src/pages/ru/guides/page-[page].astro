---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuidesList from "../../../components/GuidesList.astro";
import { getLangFromUrl } from "../../../i18n/utils";
import guides from "../../../data/guides.json";
import { dealsConfig } from "../../../config/dealsConfig.js";

export function getStaticPaths() {
  const totalPages = Math.ceil(guides.length / dealsConfig.perPage);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i.toString() },
    props: { page: i },
  }));
}

const lang = getLangFromUrl(Astro.url) || "en";
const { page } = Astro.props;
const currentPage = Number(page);

const titleMap = {
  ru: `Гайды о покере — страница ${currentPage + 1} | PokerDealsHub`,
  en: `Poker Guides — Page ${currentPage + 1} | PokerDealsHub`,
  es: `Guías de póker — Página ${currentPage + 1} | PokerDealsHub`,
};

const descMap = {
  ru: "Подробные гайды и статьи о покере, союзах, приложениях и стратегиях. Основано на реальном опыте игроков.",
  en: "Detailed poker guides and articles about unions, apps and strategies — based on real player experience.",
  es: "Guías detalladas y artículos de póker sobre uniones, aplicaciones y estrategias — basadas en experiencia real.",
};

const title = titleMap[lang] || titleMap.en;
const description = descMap[lang] || descMap.en;
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/hero_wide_screen_top.webp"
>
  <div class="container mx-auto px-4 py-8 lg:pt-12 lg:pb-12">
    <!-- Guides List -->
    <GuidesList
      currentPage={currentPage}
      perPage={dealsConfig.perPage}
      lang={lang}
    />
  </div>
</BaseLayout>
