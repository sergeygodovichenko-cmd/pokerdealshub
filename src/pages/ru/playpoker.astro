---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDeals } from '../../utils/deals';
const dealsData = await getDeals();

const telegramLink = 'https://t.me/pokerdealshub?text=Привет!%20Я%20хочу%20выбрать%20сделку';

const deals = [
  {
    title: 'Сделка в «Натс» на PPPoker',
    desc: 'Мягкие поля, стабильная игра и выгодные условия для регулярных игроков.',
    slug: 'nuts-primetime-pppoker',
  },
  {
    title: 'Сделка в Black Sea на X-Poker',
    desc: 'Много экшена, разные лимиты и комфортная игра для кэша и MTT.',
    slug: 'blacksea-xpoker',
  },
  {
    title: 'Сделка в «Дорадо» на PPPoker',
    desc: 'Хороший онлайн, рабочие поля и приятные условия по рейкбэку.',
    slug: 'eldorado-pppoker',
  },
  {
    title: 'Сделка в Massiv на ClubGG',
    desc: 'Подходит для гринда и любителей. Гибкие лимиты и удобная структура игры.',
    slug: 'massiv-clubgg',
  },
];

const appLogos = {
  pppoker: '/pppoker_logo.webp',
  'x-poker': '/xpoker_logo.webp',
  clubgg: '/clubGG_logo.webp',
  pokerbros: '/pokerbros_logo.webp',
};

const pickLogo = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('x-poker')) return appLogos['x-poker'];
  if (t.includes('clubgg')) return appLogos.clubgg;
  if (t.includes('pokerbros')) return appLogos.pokerbros;
  if (t.includes('pppoker')) return appLogos.pppoker;
  return '/chip.webp';
};

const pickAppLabel = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('x-poker')) return 'X-Poker';
  if (t.includes('clubgg')) return 'ClubGG';
  if (t.includes('pokerbros')) return 'PokerBros';
  if (t.includes('pppoker')) return 'PPPoker';
  return 'Poker';
};

const dealRakebackText = (slug: string) => {
  const found = dealsData.find((d) => d.slug === slug);
  if (found?.rakeback) return `Рейкбэк до ${found.rakeback}`;
  return 'Рейкбэк до 70%';
};

const steps = [
  {
    title: 'Скачайте приложение',
    desc: 'Установите PPPoker, X-Poker, ClubGG или PokerBros на смартфон.',
    icon: 'download',
  },
  {
    title: 'Зарегистрируйте аккаунт',
    desc: 'Создайте аккаунт. Если что-то непонятно — мы подскажем.',
    icon: 'user',
  },
  {
    title: 'Вступите в клуб и играйте',
    desc: 'Дадим ID клуба и инструкции. Внесёте депозит и садитесь за стол.',
    icon: 'chat',
  },
];

const faq = [
  {
    q: 'Как выбрать правильный клуб?',
    a: 'Смотрите на наличие игры в нужном формате (кэш, МТТ и т.д.) и на размер рейкбэка — это основа прибыли. Мы подберём клуб под ваш лимит, формат и часовой пояс.',
  },
  {
    q: 'Как скачать приложение?',
    a: 'Через App Store / Google Play или с официальных сайтов. Если доступ ограничен — дадим актуальные ссылки и инструкции.',
  },
  {
    q: 'Как сделать депозит?',
    a: 'Принимаем USDT, USDC, BTC, а также UAH, RUB, EUR, USD, UZS. Подберём удобный способ и проведём по шагам.',
  },
  {
    q: 'Как снять выигрыш?',
    a: 'Выводим в той же валюте, что и депозит: USDT, USDC, BTC, UAH, RUB, EUR, USD, UZS. Обычно выплаты занимают до 15 минут после подтверждения.',
  },
  {
    q: 'Что такое рейкбэк?',
    a: 'Рум берёт комиссию с банка — это рейк. Рейкбэк — возврат части комиссии. Если наиграли рейка на 100 и сделка даёт 50%, то 50 вернётся деньгами или бонусами. Чем выше рейкбэк, тем проще быть в плюсе на дистанции.',
  },
];
---

<BaseLayout
  title="Мобильный покер с выгодой — PokerDealsHub"
  description="Рейкбэк до 70%, мягкие поля с фишами и проверенные клубы. Подберём клуб в PPPoker, X-Poker, ClubGG и PokerBros."
>
  <div class="playpoker-page bg-neutral-950 text-neutral-100">
    <section class="w-full pt-0 lg:pt-0 pb-12 lg:pb-16 flex flex-col gap-6 lg:gap-10 lg:grid lg:grid-cols-2 lg:items-center">
      <div class="hero-frame order-1 lg:order-2 w-full">
        <img
          src="/hero_banner.webp"
          alt="Мобильный покер с PDH"
          class="hero-img"
          loading="eager"
        />
      </div>

      <div class="flex flex-col order-2 lg:order-1 max-w-2xl space-y-6 px-4 md:px-6">
        <div class="space-y-4">
          <h1 class="text-3xl md:text-5xl font-bold leading-tight text-gold drop-shadow-[0_0_24px_rgba(0,0,0,0.45)]">
            Играйте в мобильный покер на лучших условиях
          </h1>
        </div>
        <ul class="space-y-2 text-neutral-200">
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Рейкбэк до 70%</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Игра с фишами и живой экшен</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Проверенные покерные союзы и клубы</li>
          <li class="flex items-center gap-3"><span class="text-gold text-lg">✓</span> Личный менеджер и поддержка 24/7</li>
        </ul>

        <div class="space-y-2">
          <p class="text-sm uppercase tracking-wide text-neutral-400">Играем на всех топ платформах:</p>
          <div class="app-row">
            <img src="/pppoker_logo.webp" alt="PPPoker" class="app-logo" loading="lazy" />
            <img src="/xpoker_logo.webp" alt="X-Poker" class="app-logo" loading="lazy" />
            <img src="/clubGG_logo.webp" alt="ClubGG" class="app-logo" loading="lazy" />
            <img src="/pokerbros_logo.webp" alt="PokerBros" class="app-logo" loading="lazy" />
          </div>
        </div>

        <div class="flex flex-row items-center gap-3 flex-wrap">
          <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20 shrink-0"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Играть в покер
        </a>
          <p class="text-sm text-neutral-400 leading-snug">Менеджер на связи, подберём оптимальный клуб под ваши лимиты и формат игры.</p>
        </div>

      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mb-8"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16" id="deals">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gold">Лучшие предложения для игры в онлайн-покер</h2>
          <p class="text-neutral-300">Выбирайте клуб под свой формат, а мы обеспечим условия и рейкбэк.</p>
        </div>
      </div>

      <div class="grid gap-4">
        {deals.map((deal) => (
          <a
            href={`/ru/deal/${deal.slug}/`}
            class="block group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/70 rounded-xl"
          >
            <article class="bg-neutral-900/40 border border-neutral-800 rounded-xl p-4 hover:border-gold/60 transition-all group-hover:border-gold/60">
              <div class="flex items-center gap-4 mb-3">
                <img
                  src={pickLogo(deal.title)}
                  alt={pickAppLabel(deal.title)}
                  class="w-14 h-14 object-cover rounded-xl border border-neutral-700/60 shadow-[0_0_0_1px_rgba(255,255,255,0.08)]"
                  loading="lazy"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-xs uppercase tracking-wide text-neutral-400">{pickAppLabel(deal.title)}</p>
                  <h3 class="text-lg font-semibold text-gold leading-snug line-clamp-2 group-hover:text-gold-light transition-colors">
                    {deal.title}
                  </h3>
                  <span class="deal-rake-badge">
                    {dealRakebackText(deal.slug)}
                  </span>
                </div>
              </div>
              <p class="text-neutral-300 text-sm leading-relaxed line-clamp-3">{deal.desc}</p>
            </article>
          </a>
        ))}
      </div>
      <div class="mt-8 pl-3">
        <a
          href="/ru/deals/"
          class="text-gold hover:text-gold-light underline-offset-4 hover:underline font-semibold"
        >
          Все сделки
        </a>
      </div>

      <div class="mt-6 space-y-3">
        <p class="text-neutral-300">
          И множество других сделок! Напишите нам, и мы подберём лучшую под ваш банкролл, формат и цели.
        </p>
        <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20 mt-2 mb-4"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Получить рейкбэк
        </a>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16">
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gold">Как начать играть</h2>
          <p class="text-neutral-300">3 простых шага до первых раздач</p>
        </div>
        <div class="space-y-6 md:space-y-7">
          {steps.map((step, idx) => (
            <div class="flex items-start gap-4 p-4 md:p-5 bg-neutral-900/80 border border-neutral-800 rounded-xl transition duration-200 hover:border-gold/60 hover:-translate-y-0.5">
              <div class="text-gold font-semibold text-3xl md:text-4xl leading-none w-10 text-center">
                {String(idx + 1).padStart(2, '0')}
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-gold text-neutral-900 flex items-center justify-center shadow-md shadow-gold/30">
                  {step.icon === 'download' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v9m0 0 3.5-3.5M12 13 8.5 9.5M5 19h14" />
                    </svg>
                  )}
                  {step.icon === 'user' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 13a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-6 6a6 6 0 0 1 12 0" />
                    </svg>
                  )}
                  {step.icon === 'chat' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8.5 8.5 0 0 1-1.4 4.6 1 1 0 0 0-.16.51v3.02a.5.5 0 0 1-.8.4l-2.25-1.7a1 1 0 0 0-.6-.2H9a6 6 0 1 1 0-12h6a6 6 0 0 1 6 6Z" />
                    </svg>
                  )}
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-semibold text-gold">{step.title}</h3>
                  <p class="text-neutral-300 text-sm md:text-base leading-relaxed">{step.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="text-neutral-300">
          Не хотите разбираться сами? Просто напишите менеджеру — проведём от установки до первой раздачи.
        </div>
        <a
          href={telegramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors"
        >
          <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
          Начать играть
        </a>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="py-12 lg:py-14 bg-neutral-950">
      <div class="container mx-auto px-4 md:px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gold mb-8">Почему выбирают PokerDealsHub</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 text-neutral-300 max-w-5xl mx-auto">
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/shield.webp" alt="Проверенные союзы" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Проверенные союзы</h3>
            <p class="leading-relaxed">Публикуем только надёжные клубы с реальными выплатами и репутацией.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/percent.webp" alt="Честный рейкбэк" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Честный рейкбэк</h3>
            <p class="leading-relaxed">Всё прозрачно — вы всегда знаете, сколько именно получаете за игру.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/chat.webp" alt="Поддержка 24/7" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Поддержка 24/7</h3>
            <p class="leading-relaxed">Команда на связи каждый день, без выходных, поможет в любых вопросах.</p>
          </div>
          <div class="flex flex-col items-center text-center gap-3 md:gap-4 px-2">
            <img src="/fish.webp" alt="Мягкие поляны" class="w-14 h-14 mb-4 opacity-90" loading="lazy" />
            <h3 class="text-gold font-semibold mb-2">Мягкие поляны</h3>
            <p class="leading-relaxed">Сразу подбираем клубы с живым экшеном и фишными столами.</p>
          </div>
        </div>
        <div class="mt-8 flex justify-center">
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
          >
            <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
            Написать менеджеру
          </a>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6">
      <div class="border-t border-neutral-800 mt-8 md:mt-10 mb-10"></div>
    </div>

    <section class="container mx-auto px-4 pb-12 lg:pb-16">
      <div class="space-y-6">
        <h2 class="text-2xl md:text-3xl font-bold text-gold">Вопросы и ответы</h2>
        <div class="flex flex-col gap-4">
          {faq.map((item) => (
            <details class="group bg-neutral-900/90 border border-neutral-800 rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.35)] transition-colors transition-transform duration-200 hover:border-gold/60 hover:-translate-y-0.5 hover:bg-neutral-900/70">
              <summary class="cursor-pointer flex items-center justify-between gap-4 p-4 md:p-5 text-lg font-semibold text-gold">
                {item.q}
                <span class="text-gold transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="px-4 md:px-5 pb-4 md:pb-5">
                <p class="text-neutral-300 text-sm md:text-base leading-relaxed">
                  {item.a}
                </p>
              </div>
            </details>
          ))}
        </div>
        <div class="mt-6 space-y-3">
          <p class="text-neutral-300 text-base leading-relaxed">
            Остались вопросы? Наша команда с радостью поможет вам разобраться и начать играть в лучшем клубе!
          </p>
          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gold text-neutral-900 font-semibold rounded-xl hover:bg-gold-light transition-colors shadow-lg shadow-gold/20"
          >
            <img src="/telegram-button.png" alt="Telegram" class="w-7 h-7 object-contain" loading="lazy" />
            Задать вопрос
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .hero-frame {
      max-width: 620px;
      width: 100%;
    }
    .hero-img {
      width: 100%;
      height: auto;
      object-fit: contain;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .hero-title {
      font-size: clamp(24px, 5vw, 40px);
      font-weight: 800;
      line-height: 1.15;
      color: #f4c15d;
      text-shadow: 0 0 24px rgba(0, 0, 0, 0.45);
      margin: 0;
    }
    .app-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      width: 100%;
      max-width: 100%;
      justify-items: center;
      align-items: center;
    }
    .app-logo {
      width: 80px;
      height: 80px;
      object-fit: contain;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
      background: #0b0b0b;
    }
    @media (min-width: 640px) {
      .app-row {
        gap: 10px;
      }
      .app-logo {
        width: 88px;
        height: 88px;
        border-radius: 12px;
      }
    }
    @media (min-width: 1024px) {
      .hero-frame {
        aspect-ratio: 5 / 6;
      }
      .hero-img {
        height: 100%;
        object-fit: cover;
      }
    }
    .deal-rake-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 10px;
      border: 1px solid rgba(74, 222, 128, 0.7);
      color: #4ade80;
      background: rgba(16, 185, 129, 0.18);
      border-radius: 9999px;
      font-weight: 600;
      font-size: 12px;
      line-height: 1;
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
    }
  </style>
</BaseLayout>
