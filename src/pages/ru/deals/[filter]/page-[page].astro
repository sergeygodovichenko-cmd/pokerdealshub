---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DealsList from "../../../../components/DealsList.astro";
import deals from "../../../../data/deals.json";
import filterContent from "../../../../data/filterContent.json";
import { dealsConfig } from "../../../../config/dealsConfig.js";
import { getLangFromUrl } from "../../../../i18n/utils";

const lang = getLangFromUrl(Astro.url) || "ru";
const { filter, page } = Astro.params;
const content = filterContent[lang][filter];

// та же фильтрация
function filterDeals(deals, filterType) {
  const getGeoString = (geo) => (typeof geo === "string" ? geo : geo[lang] || "");
  const map = {
    centralized: d => d.type.toLowerCase() === "centralized",
    decentralized: d => d.type.toLowerCase() === "decentralized",
    pppoker: d => d.app.toLowerCase() === "pppoker",
    clubgg: d => d.app.toLowerCase() === "clubgg",
    xpoker: d => d.app.toLowerCase() === "x-poker",
    pokerbros: d => d.app.toLowerCase() === "pokerbros",
    nutspoker: d => d.app.toLowerCase() === "nuts poker",
    blacksea: d => d.union.toLowerCase() === "black sea",
    pppfish: d => d.union.toLowerCase() === "pppfish",
    eldorado: d => d.union.toLowerCase() === "el dorado",
    "nuts-primetime": d => d.union.toLowerCase() === "nuts primetime",
    "massiv-union": d => d.union.toLowerCase() === "massiv union",
    paradise: d => d.union.toLowerCase() === "paradise",
    europe: d => getGeoString(d.geo).toLowerCase().includes("европа"),
    asia: d => getGeoString(d.geo).toLowerCase().includes("азия"),
    cis: d => getGeoString(d.geo).toLowerCase().includes("снг"),
    australia: d => getGeoString(d.geo).toLowerCase().includes("австралия"),
    america: d => {
      const geo = getGeoString(d.geo).toLowerCase();
      return geo.includes("америка") || geo.includes("сша");
    },
    latam: d => getGeoString(d.geo).toLowerCase().includes("латинск"),
    mtt: d => d.ratings?.mtt === 5,
    nlh: d => d.ratings?.nlh === 5,
    plo: d => d.ratings?.plo === 5,
  };
  return deals.filter(map[filterType] || (() => true));
}

const filteredDeals = filterDeals(deals, filter);

const currentPage = Number(page);
const perPage = dealsConfig.perPage;
const totalPages = Math.ceil(filteredDeals.length / perPage);

---

<BaseLayout title={`${content.title} — страница ${currentPage + 1}`} description={content.description}>
  <DealsList
    currentPage={currentPage}
    perPage={perPage}
    lang={lang}
    dealsOverride={filteredDeals}
    filter={filter}
  />
</BaseLayout>
