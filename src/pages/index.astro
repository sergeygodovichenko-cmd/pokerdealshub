---
import { locales, languages } from "../i18n/ui";
const SITE = "https://pokerdealshub.com";
const langList = [...locales];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content="PokerDealsHub" />
    <meta property="og:description" content="Trusted poker deals and rakeback offers in leading poker apps." />
    <meta property="og:url" content="https://pokerdealshub.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://pokerdealshub.com/new_hero_mobile_top.webp" />

    <title>PokerDealsHub — your trusted source for poker club deals</title>
    <meta
      name="description"
      content="PokerDealsHub — find trusted poker deals, rakeback offers, and club reviews across ClubGG, PPPoker, X-Poker, and PokerBros unions."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    {langList.map((l) => (
      <link rel="alternate" hreflang={l} href={`${SITE}/${l}/`} />
    ))}

    <style>
      html, body {
        margin: 0; padding: 0; background: #0a0a0a; color: #d0d0d0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh; display: flex; flex-direction: column;
        align-items: center; justify-content: center; text-align: center; line-height: 1.6;
      }
      h1 { color: #f1c76e; font-size: 1.8rem; margin-bottom: 0.5rem; }
      p.intro { max-width: 600px; margin: 0 auto 1.5rem; color: #aaa; font-size: 1.05rem; }
      .langs { max-width: 720px; display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; justify-content: center; }
      a { color: #f1c76e; text-decoration: none; font-weight: 500; transition: opacity 0.2s ease; }
      a:hover { opacity: 0.8; }
      footer { position: absolute; bottom: 1rem; color: #555; font-size: 0.8rem; }
    </style>
  </head>

  <body>
    <main>
      <h1>PokerDealsHub</h1>
      <p class="intro">
        Welcome to PokerDealsHub — a global directory of trusted poker clubs and unions
        offering verified rakeback deals, secure payouts, and honest game environments
        across major poker apps. Available in 15 languages.
      </p>
      <p>Choose your language:</p>
      <nav class="langs">
        {langList.map((l) => (
          <a href={`/${l}/`} hreflang={l} lang={l}>{languages[l as keyof typeof languages]}</a>
        ))}
      </nav>
    </main>

    <footer>© 2025 PokerDealsHub</footer>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "PokerDealsHub",
        "url": "https://pokerdealshub.com/",
        "logo": "https://pokerdealshub.com/PDH_logo_no_background.webp",
        "sameAs": ["https://t.me/pokerdealshub", "https://www.instagram.com/poker_deals_hub/"]
      }
    </script>

    <script define:vars={{ active: langList }}>
      (function () {
        try {
          const alias = { iw: "he", tl: "fil", in: "id" }; // legacy/ISO variants -> our locales
          const cands = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "en"]);
          let pick = "en";
          for (const c of cands) {
            const full = String(c).toLowerCase();
            const base = full.split("-")[0];
            const m = alias[full] || alias[base] || (active.includes(base) ? base : null);
            if (m) { pick = m; break; }
          }
          setTimeout(() => { window.location.replace(`/${pick}/`); }, 800);
        } catch (e) {
          window.location.replace("/en/");
        }
      })();
    </script>
  </body>
</html>
