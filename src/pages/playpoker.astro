---
// Static redirect /playpoker/ -> default-locale landing.
const target = "/ru/playpoker/";
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <a href={target}>PokerDealsHub</a>
  </body>
</html>
