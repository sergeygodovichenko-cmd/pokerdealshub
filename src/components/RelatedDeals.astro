---
import { getLangFromUrl } from '../i18n/utils';
import deals from '../data/deals.json';

interface Props {
  currentDealSlug: string;
  currentApp?: string;
  currentGeo?: string;
  currentBadges?: string[];
}

const { currentDealSlug, currentApp, currentGeo, currentBadges } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const scoreDeal = (deal: typeof deals[0]) => {
  let score = 0;
  if (deal.app === currentApp) score += 3;
  if (deal.geo === currentGeo) score += 2;
  if (currentBadges?.some(badge => deal.badges?.includes(badge))) score += 1;
  return score;
};

const relatedDeals = deals
  .filter(deal => deal.slug !== currentDealSlug)
  .map(deal => ({ ...deal, score: scoreDeal(deal) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 2);

const logoMap: Record<string, string> = {
  'pppoker': '/image.webp',
  'xpoker': '/xpoker_logo.webp',
  'clubgg': '/clubGG_logo.webp',
};

const titles = {
  ru: 'Похожие предложения',
  en: 'Similar Offers',
  es: 'Ofertas Similares'
};

const buttonText = {
  ru: 'Подробнее',
  en: 'Learn More',
  es: 'Más información'
};
---

{relatedDeals.length > 0 && (
  <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 lg:p-8">
    <h2 class="text-2xl font-bold text-gold mb-6">{titles[lang as keyof typeof titles]}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {relatedDeals.map((deal) => {
        const logoUrl = logoMap[deal.logo] || '/image.webp';
        return (
          <article class="bg-neutral-800/50 border border-neutral-700 rounded-xl p-4 hover:border-gold/50 transition-all">
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-4">
                <img src={logoUrl} alt={deal.name[lang]} class="w-20 h-auto object-contain rounded-lg" />
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold text-gold mb-1 line-clamp-2">
                    {deal.name[lang]}
                  </h3>
                  <p class="text-sm text-neutral-400">
                    {deal.app} • {deal.geo}
                  </p>
                </div>
              </div>
              <p class="text-neutral-300 text-sm line-clamp-3">
                {deal.description[lang]}
              </p>
              <a
                href={`/${lang}/deal/${deal.slug}/`}
                class="w-full px-6 py-3 bg-gold/10 text-gold border border-gold/30 rounded-lg font-semibold text-center hover:bg-gold/20 transition-all"
              >
                {buttonText[lang as keyof typeof buttonText]}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
)}
