---
import deals from "../data/deals.json";
import { dealsConfig } from "../config/dealsConfig.js";
import DealCard from "./DealCard.astro";

interface Props {
  currentPage?: number;
  perPage?: number;
  lang: string;
  filter?: string;
  dealsOverride?: any[];
}

const {
  currentPage = dealsConfig.defaultPage ?? 0,
  perPage = dealsConfig.perPage ?? 8,
  lang = "ru",
  filter = "",
  dealsOverride,
} = Astro.props;

// 🔹 Берём переданные сделки (отфильтрованные и отсортированные)
const sorted = dealsOverride
  ? dealsOverride
  : [...deals].sort(dealsConfig.sortDeals);

const totalPages = Math.ceil(sorted.length / perPage);
const start = currentPage * perPage;
const end = start + perPage;
const pageSlice = sorted.slice(start, end);
---

<div id="deals-section">
  <div id="deals-list" class="flex flex-col gap-4">
    {pageSlice.map((deal) => (
      <DealCard deal={deal} />
    ))}
  </div>

  <div id="observer-trigger" class="h-6 w-full"></div>

  {currentPage + 1 < totalPages && (
    <div class="mt-6 flex justify-center">
      <button
        id="load-more"
        class="px-6 py-3 rounded-xl bg-gold text-neutral-900 font-bold hover:bg-gold-light transition"
        data-current-page={currentPage}
        data-total-pages={totalPages}
        data-lang={lang}
        data-filter={filter}
      >
        Показать ещё
      </button>
    </div>
  )}

  <div id="deals-loader" class="flex justify-center py-4" style="display:none">
    <span class="animate-pulse text-neutral-400">Загрузка...</span>
  </div>
</div>

<script>
  (function () {
    if (window.PDH_DEALS_INIT) return;
    window.PDH_DEALS_INIT = true;

    const container = document.querySelector("#deals-list");
    const trigger = document.querySelector("#observer-trigger");
    const btn = document.querySelector("#load-more");
    const loader = document.querySelector("#deals-loader");
    if (!container || !btn) return;

    let currentPage = Number(btn.dataset.currentPage ?? 0);
    const totalPages = Number(btn.dataset.totalPages ?? 1);
    const lang = btn.dataset.lang || "ru";
    const filter = btn.dataset.filter || "";
    let isLoading = false;

    async function loadNextPage() {
      if (isLoading || currentPage + 1 >= totalPages) return;
      isLoading = true;
      loader.style.display = "flex";

      const nextPage = currentPage + 1;
      // ✅ теперь учитываем фильтр в URL
      const nextUrl = filter
  ? `/${lang}/deals/${filter}/page-${nextPage}`
  : `/${lang}/deals/page-${nextPage}`;


      try {
        const res = await fetch(nextUrl);
        if (!res.ok) throw new Error("Failed to fetch " + nextUrl);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        const newCards = doc.querySelectorAll("article");

        newCards.forEach((card) => {
          card.style.opacity = "0";
          container.appendChild(card);
          requestAnimationFrame(() => (card.style.opacity = "1"));
        });

        currentPage = nextPage;

        if (currentPage + 1 >= totalPages) {
          btn.remove();
          observer.disconnect();
        }
      } catch (err) {
        console.error("Ошибка подгрузки:", err);
      } finally {
        loader.style.display = "none";
        isLoading = false;
      }
    }

    btn.addEventListener("click", (e) => {
      e.preventDefault();
      loadNextPage();
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (entry.isIntersecting && !isLoading) {
          setTimeout(() => btn.click(), 150);
        }
      },
      { rootMargin: "700px 0px 0px 0px", threshold: 0.01 }
    );

    observer.observe(trigger);
  })();
</script>
