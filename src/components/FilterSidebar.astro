    byGeo: 'По географии',
    byFormat: 'По типу игры',
    filters: {
      centralized: 'Централизованные',
      decentralized: 'Децентрализованные',
      pppoker: 'PPPoker',
      clubgg: 'ClubGG',
      xpoker: 'X-Poker',
      pokerbros: 'PokerBros',
      nutspoker: 'Nuts poker',
      blacksea: 'Black Sea',
      pppfish: 'PPPfish',
      eldorado: 'El Dorado',
      'nuts-primetime': 'Nuts PrimeTime',
      'massiv-union': 'Massiv Union',
      paradise: 'Paradise',
      europe: 'Европа',
      asia: 'Азия',
      cis: 'СНГ',
      australia: 'Австралия',
      america: 'Америка',
      latam: 'Латинская Америка',
      mtt: 'MTT',
      cash: 'Cash',
      plo: 'PLO',
      nlh: 'NLH',
    },
  },
  en: {
    allDeals: 'All Deals',
    filterLabel: 'Filter:',
    byType: 'By Type',
    byApp: 'By App',
    byUnion: 'By Union',
    byGeo: 'By Geography',
    byFormat: 'By Game Type',
    filters: {
      centralized: 'Centralized',
      decentralized: 'Decentralized',
      pppoker: 'PPPoker',
      clubgg: 'ClubGG',
      xpoker: 'X-Poker',
      pokerbros: 'PokerBros',
      nutspoker: 'Nuts poker',
      blacksea: 'Black Sea',
      pppfish: 'PPPfish',
      eldorado: 'El Dorado',
      'nuts-primetime': 'Nuts PrimeTime',
      'massiv-union': 'Massiv Union',
      paradise: 'Paradise',
      europe: 'Europe',
      asia: 'Asia',
      cis: 'CIS',
      australia: 'Australia',
      america: 'America',
      latam: 'LatAm',
      mtt: 'MTT',
      cash: 'Cash',
      plo: 'PLO',
      nlh: 'NLH',
    },
  },
  es: {
    allDeals: 'Todas las Ofertas',
    filterLabel: 'Filtro:',
    byType: 'Por Tipo',
    byApp: 'Por Aplicación',
    byUnion: 'Por Unión',
    byGeo: 'Por Geografía',
    byFormat: 'Por Tipo de Juego',
    filters: {
      centralized: 'Centralizadas',
      decentralized: 'Descentralizadas',
      pppoker: 'PPPoker',
      clubgg: 'ClubGG',
      xpoker: 'X-Poker',
      pokerbros: 'PokerBros',
      nutspoker: 'Nuts poker',
      blacksea: 'Black Sea',
      pppfish: 'PPPfish',
      eldorado: 'El Dorado',
      'nuts-primetime': 'Nuts PrimeTime',
      'massiv-union': 'Massiv Union',
