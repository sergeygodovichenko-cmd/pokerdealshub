---

<aside class="w-full lg:w-64 flex-shrink-0">
  <div id="sidebar-content" class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
    <a
      href={`/${lang}/deals/`}
      class={`block mb-6 px-4 py-2 rounded-lg font-medium transition-colors ${
        !currentFilter
          ? 'bg-gold text-neutral-900'
          : 'text-neutral-300 hover:bg-neutral-800'
      }`}
    >
      {t.allDeals}
    </a>

    <div class="space-y-6">
      {categories.map((category) => (
        <div>
          <h3 class="text-sm font-semibold text-gold mb-3">{category.title}</h3>
          <div class="space-y-1">
            {category.filters.map((filter) => (
              <a
                href={`/${lang}/deals/${filter}/`}
                class={`block px-4 py-2 text-sm rounded-lg transition-colors ${
                  currentFilter === filter
                    ? 'bg-gold text-neutral-900 font-medium'
                    : 'text-neutral-300 hover:bg-neutral-800'
                }`}
              >
                {t.filters[filter as keyof typeof t.filters]}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="mobile-backdrop" class="hidden"></div>
</aside>

<button
  id="mobile-filter-toggle"
  class="lg:hidden fixed bottom-6 right-6 z-[100] bg-gold text-neutral-900 rounded-lg shadow-2xl hover:bg-gold-light transition-all active:scale-95 px-4 py-3 flex flex-col items-start gap-1 max-w-[140px]"
  aria-label="Toggle filters"
>
  <div class="flex items-center gap-2 w-full">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
    </svg>
    <span class="text-xs font-semibold leading-tight">{t.filterLabel}</span>
  </div>
  <div class="text-sm font-bold leading-tight w-full truncate text-left">
    {currentFilter ? t.filters[currentFilter as keyof typeof t.filters] : t.allDeals}
  </div>
</button>

<a
  id="telegram-chat-bubble"
  class="lg:hidden fixed right-6 z-[110] flex items-center justify-center shadow-2xl overflow-hidden"
  href="https://t.me/pokerdealshub"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.chatCta || 'Open Telegram chat'}
>
  <img src="/telegram-button.png" alt="" class="w-full h-full object-cover rounded-full" />
</a>

<style>
  :global(:root) {
    --mobile-filter-height: 64px;
  }

  @media (max-width: 1023px) {
    #sidebar-content {
      position: fixed;
      left: -100%;
      width: 85%;
      max-width: 320px;
      z-index: 60;
      transition: left 0.3s ease;
      border-radius: 0;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      box-shadow: 2px 0 8px rgba(0, 0, 0, 0.5);
      padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
      background-color: #0a0a0a;
    }

    aside.mobile-open #sidebar-content {
      left: 0;
    }

    #mobile-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      z-index: 50;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      backdrop-filter: blur(2px);
    }

    aside.mobile-open #mobile-backdrop {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }
  }

  #mobile-filter-toggle {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 140px;
    height: var(--mobile-filter-height, 64px);
    opacity: 0.001;
    animation: appear 0.4s ease 0.3s forwards;
  }

  @keyframes appear {
    to { opacity: 1; }
  }

  /* адаптив под высоту хедера */
  @media (max-width: 767px) {
    #sidebar-content {
      top: 64px;
      height: calc(100dvh - 64px - env(safe-area-inset-bottom, 0px));
      min-height: calc(100vh - 64px - env(safe-area-inset-bottom, 0px));
    }
  }

  @media (min-width: 768px) {
    #sidebar-content {
      top: 74px;
      height: calc(100dvh - 74px - env(safe-area-inset-bottom, 0px));
      min-height: calc(100vh - 74px - env(safe-area-inset-bottom, 0px));
    }
  }

  #telegram-chat-bubble {
    bottom: calc(1.5rem + var(--mobile-filter-height, 64px) + 1.75rem + env(safe-area-inset-bottom, 0px));
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    background: transparent;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #telegram-chat-bubble:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
  }

  #telegram-chat-bubble:active {
    transform: scale(0.97);
  }

  @media (min-width: 1024px) {
    aside {
      display: flex;
      flex-direction: column;
      height: auto;
    }

    #sidebar-content {
      position: static;
      height: auto;
      min-height: auto;
      max-height: none;
      border-radius: 0.75rem; /* вернуть округление, если обрезалось */
      box-shadow: none;
    }
  }
</style>


<script>
  const toggle = document.getElementById('mobile-filter-toggle');
  const sidebar = document.querySelector('aside');
  const backdrop = document.getElementById('mobile-backdrop');
  const sidebarContent = document.getElementById('sidebar-content');

  // === Умная коррекция высоты для Safari ===
  function fixSidebarHeight() {
    const header = document.getElementById('site-header');
    if (!header || !sidebarContent) return;
    const headerHeight = header.offsetHeight;
    const vh = window.innerHeight;
    sidebarContent.style.top = `${headerHeight}px`;
    sidebarContent.style.height = `calc(${vh}px - ${headerHeight}px)`;
  }

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    sidebar?.classList.toggle('mobile-open');
    if (sidebar?.classList.contains('mobile-open')) {
      document.body.style.overflow = 'hidden';
      fixSidebarHeight();
    } else {
      document.body.style.overflow = '';
    }
  });

  backdrop?.addEventListener('click', () => {
    sidebar?.classList.remove('mobile-open');
    document.body.style.overflow = '';
  });

  sidebarContent?.addEventListener('click', (e) => {
    const target = e.target;
    if (target.tagName === 'A') {
      sidebar?.classList.remove('mobile-open');
      document.body.style.overflow = '';
      sidebarContent.style.transition = 'none';
      sidebarContent.style.left = '-100%';
      backdrop.style.transition = 'none';
      backdrop.style.opacity = '0';
      backdrop.style.pointerEvents = 'none';
      backdrop.style.display = 'none';
    }
  });

  window.addEventListener('resize', fixSidebarHeight);
  window.addEventListener('orientationchange', fixSidebarHeight);
</script>
