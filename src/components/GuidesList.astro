---
import guides from "../data/guides.json";
import { dealsConfig } from "../config/dealsConfig.js";

interface Props {
  currentPage?: number;
  perPage?: number;
  lang: string;
  guidesOverride?: any[];
}

const {
  currentPage = 0,
  perPage = dealsConfig.perPage ?? 8,
  lang = "ru",
  guidesOverride,
} = Astro.props;

const sorted = guidesOverride ? guidesOverride : [...guides];
const totalPages = Math.ceil(sorted.length / perPage);
const start = currentPage * perPage;
const end = start + perPage;
const pageSlice = sorted.slice(start, end);
---

<div id="guides-section">
  <div id="guides-list" class="flex flex-col gap-6">
    {pageSlice.map((guide) => (
      <article class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 hover:border-gold transition-all group">
        <div class="flex items-start justify-between mb-3">
          <span class={`text-xs px-3 py-1 rounded-full ${
            guide.category === "guide"
              ? "bg-blue-500/20 text-blue-400"
              : "bg-green-500/20 text-green-400"
          }`}>
            {guide.category === "guide" ? (lang === "ru" ? "Гайд" : "Guide") : (lang === "ru" ? "Обзор" : "Review")}
          </span>
          <time class="text-sm text-neutral-500">
            {new Date(guide.date).toLocaleDateString(lang === "ru" ? "ru-RU" : "en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </div>

        <h2 class="text-2xl font-semibold text-gold group-hover:text-gold-light transition-colors mb-3">
          <a href={`/${lang}/guides/${guide.slug}/`}>
            {guide.title[lang]}
          </a>
        </h2>

        <p class="text-neutral-400 mb-4">{guide.description[lang]}</p>

        <a
          href={`/${lang}/guides/${guide.slug}/`}
          class="inline-flex items-center text-gold hover:text-gold-light transition-colors text-sm font-medium"
        >
          {lang === "ru" ? "Читать далее" : "Read more"}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </a>
      </article>
    ))}
  </div>

  <div id="observer-trigger" class="h-6 w-full"></div>

  {currentPage + 1 < totalPages && (
    <div class="mt-6 flex justify-center">
      <button
        id="load-more"
        class="px-6 py-3 rounded-xl bg-gold text-neutral-900 font-bold hover:bg-gold-light transition"
        data-current-page={currentPage}
        data-total-pages={totalPages}
        data-lang={lang}
      >
        {lang === "ru" ? "Показать ещё" : "Show more"}
      </button>
    </div>
  )}

  <div id="guides-loader" class="flex justify-center py-4" style="display:none">
    <span class="animate-pulse text-neutral-400">
      {lang === "ru" ? "Загрузка..." : "Loading..."}
    </span>
  </div>
</div>

<script>
  (function () {
    if (window.PDH_GUIDES_INIT) return;
    window.PDH_GUIDES_INIT = true;

    const container = document.querySelector("#guides-list");
    const trigger = document.querySelector("#observer-trigger");
    const btn = document.querySelector("#load-more");
    const loader = document.querySelector("#guides-loader");
    if (!container || !btn) return;

    let currentPage = Number(btn.dataset.currentPage ?? 0);
    const totalPages = Number(btn.dataset.totalPages ?? 1);
    const lang = btn.dataset.lang || "ru";
    let isLoading = false;

    async function loadNextPage() {
      if (isLoading || currentPage + 1 >= totalPages) return;
      isLoading = true;
      loader.style.display = "flex";

      const nextPage = currentPage + 1;
      const nextUrl = `/${lang}/guides/page-${nextPage}/`;

      try {
        const res = await fetch(nextUrl);
        if (!res.ok) throw new Error("Failed to fetch " + nextUrl);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        const newCards = doc.querySelectorAll("article");

        newCards.forEach((card) => {
          card.style.opacity = "0";
          container.appendChild(card);
          requestAnimationFrame(() => (card.style.opacity = "1"));
        });

        currentPage = nextPage;

        if (currentPage + 1 >= totalPages) {
          btn.remove();
          observer.disconnect();
        }
      } catch (err) {
        console.error("Ошибка подгрузки:", err);
      } finally {
        loader.style.display = "none";
        isLoading = false;
      }
    }

    btn.addEventListener("click", (e) => {
      e.preventDefault();
      loadNextPage();
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (entry.isIntersecting && !isLoading) {
          setTimeout(() => btn.click(), 150);
        }
      },
      { rootMargin: "700px 0px 0px 0px", threshold: 0.01 }
    );

    observer.observe(trigger);
  })();
</script>
